+# TF_GLM_MTP_CHAIN: the automatic policy's MTP chains: "fixed" (3 drafts; greedy cut at confidence 0.35, sampled by
+# running acceptance) or "cost" (up to TF_GLM_MTP_COST_MOST drafts, each kept while the round's expected tokens a ms
+# grow, by the startup cost table; ``decode.draft``)
+MTP_CHAIN = os.environ.get("TF_GLM_MTP_CHAIN", "fixed").strip()
+if MTP_CHAIN not in ("fixed", "cost"):
+    raise ValueError(f"TF_GLM_MTP_CHAIN: fixed or cost, not {MTP_CHAIN!r}")
+MTP_COST_MOST = int(os.environ.get("TF_GLM_MTP_COST_MOST", "7"))
+
+
+def mtp_round_costs(costs: dict, most: int) -> tuple[float, ...]:
+    """ms of an MTP round of k drafts, k = 0 .. most: the verify window of k + 1 rows, the first MTP step (with the
+    kept rows' absorb) and k - 1 chained steps."""
+
+    verify = costs["verify"]
+    most = min(most, len(verify) - 1)
+    return tuple(verify[k] + (costs["mtp"] + (k - 1) * costs["mtp_step"] if k else 0.0) for k in range(most + 1))
+
