+def _bits(w: torch.Tensor) -> np.ndarray:
+    """A host bf16 tensor's raw 16-bit words as a NumPy view (no copy)."""
+
+    return w.view(torch.int16).numpy()
+
+
+def _bf16_rows(bits: np.ndarray, idx) -> np.ndarray:
+    """Rows of a bf16 matrix (its raw words) as float64: exactly torch's bf16 -> double (bf16 is float32's top half),
+    in NumPy: ~1 ms a slot of torch dispatch becomes ~20 us, the same bits."""
+
+    return (bits[idx].astype(np.uint16).astype(np.uint32) << 16).view(np.float32).astype(np.float64)
+
+
