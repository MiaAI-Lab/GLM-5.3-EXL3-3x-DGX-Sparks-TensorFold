@@ -0,0 +1,33 @@
+"""Mia's sparse attention (msa.cu): full GLM-5.3's prompt rows over their selected tokens on an FP8 latent cache, one
+block a row (tensor cores, the next tile's gather in flight), straight to the output: no partials, no merge. A row's
+bits depend on its query, its token list and the cache only (any chunking, any run). By Mia's AI Lab (Apache-2.0)."""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+HEADS = 24                    # query heads a rank at most (full GLM-5.3: 22 / 21 / 21 at three ranks)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_msa_v3", sources=[str(here / "msa.cpp"), str(here / "msa.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo"], verbose=False)
+
+
+def supported(qa: torch.Tensor, cache: torch.Tensor, rope: torch.Tensor | None) -> bool:
+    return (rope is not None and cache.dtype == torch.uint8 and cache.shape[-1] == 528 and qa.shape[-1] == 512
+            and qa.shape[1] <= HEADS and rope.shape[-1] == 64)
+
+
+def prompt(qa: torch.Tensor, cache: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor, out: torch.Tensor,
+           scale: float, qp: torch.Tensor, rope: torch.Tensor) -> None:
+    """latent.sparse_attention for prompt rows: rows with counts > 0 attend their tokens (ascending, -1 padded)."""
+
+    _ext().prompt(qa, qp, cache, rope, tokens, counts, out, float(scale))
