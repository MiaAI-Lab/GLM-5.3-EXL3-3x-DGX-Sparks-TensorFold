+def hybrid_round(drafter, copies, h, pending: int, depth: int, room: int, sampling: Sampling | None,
+                 policy: DepthPolicy) -> tuple[list[int], str]:
+    """A round's drafts under TF_GLM_COPY_HYBRID (``copy_drafts.CopyDrafts.plan`` and ``hybrid``) and its kind: "s"
