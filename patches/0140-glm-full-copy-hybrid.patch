+class RecordDrafter:
+    """A dump record standing in for ``dspark.Drafter`` at reply position i (its block's view there)."""
+
+    def __init__(self, r: Record, i: int) -> None:
+        self.r, self.i = r, i
+        self.block = r.cand.shape[1]
+        self._slot = None
+
+    def slot(self) -> cd.Slot:
+        if self._slot is None:
+            self._slot = record_slot(self.r, self.i)
+        return self._slot
+
+    def propose(self, pending, depth, sampling, confidence=0.0, **_) -> list[int]:
+        return cd.walk(self.r.cand[self.i], self.slot(), min(depth, self.block), confidence)[0]
+
+    def propose_hybrid(self, pending, conts, depth, sampling, confidence=0.0, *, rank=1, most=15, **_):
+        drafts, kind, k, _ = cd.hybrid(self.r.cand[self.i], self.slot(), conts, chain_most=min(depth, self.block),
+                                       confidence=confidence, rank=rank, most=most)
+        return drafts, kind, k
+
+
+def prompt_ids(r: Record) -> list[int]:
+    """The dump's prompt ids (version 2 dumps), or with SCENARIO a synthetic prompt quoting the reply: "edit" (the
+    whole reply, ~3% of its tokens substituted, deleted or inserted), "mixed" (half of its 40-token pieces verbatim,
+    the rest absent). Synthetic: DSpark's recorded view never saw that prompt (a real one would agree more)."""
+
+    ids = [int(t) for t in r.prompt] if r.prompt is not None else []
+    if SCENARIO == "none":
+        return ids
+    rng = np.random.default_rng(int(r.meta.get("seed", 0)) * 7919 + len(r.tokens))
+    reply = [int(t) for t in r.tokens[1:]]
+    out: list[int] = []
+    if SCENARIO == "edit":
+        for t in reply:
+            u = rng.random()
+            if u < 0.01:
+                continue                                      # deleted
+            out.append(int(rng.choice(reply)) if u < 0.02 else t)   # substituted
+            if 0.02 <= u < 0.03:
+                out.append(int(rng.choice(reply)))            # inserted
+    elif SCENARIO == "mixed":
+        for a in range(0, len(reply), 40):
+            if rng.random() < 0.5:
+                out += reply[a:a + 40]
+    else:
+        raise ValueError(SCENARIO)
+    return ids + out
+
+
+def simulate(r: Record, p: Policy, eager: float = EAGER, block: float = BLOCK, *, check: bool = False) -> dict:
+    """Rounds, tokens, ms and per-kind counts of decoding the reply under p (``check``: assert the no-copy chain is
+    the recorded production chain at every round)."""
+
+    toks = [int(t) for t in r.tokens]
+    n, count = len(toks) - 1, int(r.meta["count"])
+    prompt = prompt_ids(r)
+    copies = None
+    if p.copies != "none":
+        match = p.hybrid.match if p.copies == "hybrid" else p.match
+        copies = cd.CopyDrafts(prompt + toks[:1], match, p.most, prompt=len(prompt),
+                               hybrid=p.hybrid if p.copies == "hybrid" else None)
+    i = rounds = 0
+    ms = 0.0
+    kinds: dict[str, list[int]] = {}         # kind -> [rounds, drafted, kept]
+    while i < n:
+        room = count - (i + 1) - 1
+        depth = min(p.chain_most, count - (i + 1))
+        ran = True
+        kind = "d"
+        if copies is not None and p.copies == "prod":
+            drafts = copies.propose(room)
+            if drafts:
+                kind, ran = "c", False
+        else:
+            drafts = []
+        if copies is not None and p.copies == "hybrid":         # the engine's own round (``decode.hybrid_round``)
+            from .decode import hybrid_round
+
+            drafts, kind = hybrid_round(RecordDrafter(r, i), copies, p.hybrid, toks[i], depth, room, r.sampling,
+                                        _Rule(p.confidence))
+            ran = kind not in ("s", "c")
+            if kind == "d" and check:
+                want = [int(t) for t in r.prod[i] if t >= 0][:depth]
+                assert drafts == want or depth < 5, (i, drafts, want)
+        if kind == "d" and p.copies != "hybrid":
+            drafts = cd.walk(r.cand[i], record_slot(r, i), depth, p.confidence)[0] if depth > 0 else []
+            if check:
+                want = [int(t) for t in r.prod[i] if t >= 0][:depth]
+                assert drafts == want or depth < 5, (i, drafts, want)
+        acc = 0
+        while acc < len(drafts) and i + 1 + acc <= n and drafts[acc] == toks[i + 1 + acc]:
+            acc += 1
+        keep = acc + 1
+        ms += verify_ms(1 + len(drafts), eager) + (block if ran else 0.0)
+        k3 = kinds.setdefault(kind, [0, 0, 0])
+        k3[0] += 1
+        k3[1] += len(drafts)
+        k3[2] += acc
+        if copies is not None:
+            copies.extend(toks[i + 1:i + 1 + keep])
+        i += keep
+        rounds += 1
+    return dict(tokens=n, rounds=rounds, ms=ms, kinds=kinds)
+
+
+def label(path: Path, r: Record) -> tuple[str, str]:
+    """(kind, run) of a lab/dump_collect.py dump by its sequence number (dumps 1-2: warm-up requests)."""
+
+    if "kind" in r.meta:
+        return r.meta["kind"], r.meta.get("run", "?")
+    seq = int(path.stem.rsplit("-", 1)[-1]) - 3
+    if seq < 0:
+        return "warmup", "greedy" if r.sampling is None else "sampled"
+    return KINDS[seq % 10], RUNS[(seq // 10) % 4]
+
+
+H = cd.HybridSettings
+POLICIES = [
+    Policy("dspark only (fc5:0.3)"),
+    Policy("production copies (max 15)", copies="prod"),
+    Policy("production copies (max 8)", copies="prod", most=8),
+    Policy("hybrid (default, max 15)", copies="hybrid"),
+    Policy("hybrid (max 8)", copies="hybrid", most=8),
+    Policy("hybrid, vetted only", copies="hybrid", hybrid=H(trust_prompt=0, trust_reply=0)),
+    Policy("hybrid, no skip", copies="hybrid", hybrid=H(skip=False)),
+    Policy("hybrid, 3-token match", copies="hybrid", hybrid=H(3)),
+    Policy("hybrid, rank 2", copies="hybrid", hybrid=H(rank=2)),
+    Policy("hybrid, 1 source", copies="hybrid", hybrid=H(sources=1)),
+]
+
+
+def main(argv: list[str]) -> None:
+    eager, block = EAGER, BLOCK
+    if "--eager" in argv:
+        k = argv.index("--eager")
+        eager = float(argv[k + 1])
+        argv = argv[:k] + argv[k + 2:]
+    global SCENARIO
+    if "--scenario" in argv:
+        k = argv.index("--scenario")
+        SCENARIO = argv[k + 1]
+        argv = argv[:k] + argv[k + 2:]
+    if "--block" in argv:
+        k = argv.index("--block")
+        block = float(argv[k + 1])
+        argv = argv[:k] + argv[k + 2:]
+    files = []
+    for a in argv:
+        q = Path(a)
+        files += sorted(q.glob("*.npz")) if q.is_dir() else [q]
+    rows = []          # (kind, run, policy, result)
+    for f in files:
+        r = load(f)
+        kind, run = label(f, r)
+        for p in POLICIES:
+            rows.append((kind, run, p.name, simulate(r, p, eager, block, check=True)))
+        del r
+        print(f"{f.name}: {kind} {run}", file=sys.stderr, flush=True)
+    report(rows, eager, block)
+
+
+def report(rows, eager, block) -> None:
+    print(f"verify ms 1..9 rows {VERIFY}, past 9 rows +{eager} ms eager; block {block} ms")
+
+    def group(sel, title):
+        sub = [x for x in rows if sel(x)]
+        if not sub:
+            return
+        base = None
+        print(f"-- {title}: {len(sub) // len(POLICIES)} replies")
+        for p in POLICIES:
+            rs = [x[3] for x in sub if x[2] == p.name]
+            t, rd, ms = sum(x["tokens"] for x in rs), sum(x["rounds"] for x in rs), sum(x["ms"] for x in rs)
+            tps = 1000.0 * t / ms
+            base = tps if base is None else base
+            agg: dict[str, list[int]] = {}
+            for x in rs:
+                for k, v in x["kinds"].items():
+                    a = agg.setdefault(k, [0, 0, 0])
+                    for z in range(3):
+                        a[z] += v[z]
+            ks = " ".join(f"{k}:{v[0]}r/{v[2]}of{v[1]}" for k, v in sorted(agg.items()))
+            print(f"  {p.name:>28}: tok/round {t / rd:.3f}, est {tps:5.1f} tok/s ({100 * (tps / base - 1):+5.1f}%)  "
+                  + ks)
+
+    group(lambda x: x[0] != "warmup", "all")
+    for run in RUNS[1:]:
+        group(lambda x, run=run: x[1] == run and x[0] != "warmup", run)
+    for kind in ("prose", "chat", "code", "math"):
+        group(lambda x, kind=kind: x[0] == kind, kind)
+        for run in ("sampled", "greedy", "sampled-think"):
+            group(lambda x, kind=kind, run=run: x[0] == kind and x[1] == run, f"{kind} / {run}")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
