+"""Offline replay of copy drafts with DSpark over ``draft_dump`` records (TF_GLM_DRAFT_DUMP with DRAFTER=dspark).
+
+A dump is a serial reply with DSpark's view at every position (``dspark_sim``); a copy index over the reply (and the
+prompt, when the dump holds its ids: ``prompt``, dump version 2) gives the copy continuations a round would see.
+``simulate`` follows the decode as ``decode.dflash_decode`` would under a policy: each round proposes from the record
+at its position (DSpark's slots through ``record_slot``, the same float64 terms as the drafter's), the verifier keeps
+the drafts equal to the reply's next tokens, and the round costs its verify window plus the block when it ran.
+
+Policies: "dspark" (no copies), "prod" (today's copies: a copy replaces the block, the latest occurrence), and the
+hybrid (TF_GLM_COPY_HYBRID: ``decode.hybrid_round`` itself, over a ``RecordDrafter``). Rounds cost the measured verify
+table (past 9 rows: the slope plus ``--eager`` ms for an uncaptured window) and the block where it ran.
+``--scenario edit|mixed``: a synthetic prompt quoting the reply (``prompt_ids``) for dumps without prompt ids; DSpark's
+recorded view never saw it, so vetted copies are understated there.
+
+    python3 -m tensorfold.families.glm5_next.cuda.copy_sim <dump dir or .npz> ... [--eager MS] [--block MS]
+        [--scenario none|edit|mixed]
+"""
+
+from __future__ import annotations
+
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+
+from . import copy_drafts as cd
+from .dspark_sim import Record, load
+
+# measured verify ms of 1..9 rows (graphs; 2026-10-04) and the DSpark block
+VERIFY = (52.4, 64.3, 74.7, 84.4, 95.4, 104.1, 112.3, 121.0, 127.9)
+BLOCK = 3.4
+EAGER = 25.0          # assumed extra ms of an eager (uncaptured) window past 9 rows; wider rows extrapolate the slope
+KINDS = ("prose", "prose", "prose", "chat", "chat", "code", "code", "code", "code", "math")   # lab/dump_collect.py
+RUNS = ("sampled", "sampled", "greedy", "sampled-think")
+
+
+def verify_ms(rows: int, eager: float = EAGER, table=VERIFY) -> float:
+    if rows <= len(table):
+        return table[rows - 1]
+    slope = (table[-1] - table[-4]) / 3
+    return table[-1] + slope * (rows - len(table)) + eager
+
+
+@dataclass(frozen=True)
+class Policy:
+    name: str
+    copies: str = "none"          # none | prod | hybrid
+    match: int = cd.MATCH
+    most: int = 15                # copy drafts at most (TF_GLM_COPY_MAX)
+    chain_most: int = 5           # DSpark's chain (production fc5:0.3)
+    confidence: float = 0.3
+    hybrid: cd.HybridSettings = cd.HybridSettings()
+
+
+def record_slot(r: Record, i: int) -> cd.Slot:
+    """``copy_drafts.Slot`` of record i: ``dspark_sim.chain``'s arithmetic (``Drafter.chain``'s), memoized."""
+
+    from .dspark import target_kept
+
+    m = r.meta
+    sampled = r.sampling is not None
+    temp = float(r.sampling.temperature) if sampled else 1.0
+    weight, use_filter = m["dspark_noise"], m["dspark_filter"]
+    memo: dict[tuple[int, int], tuple[np.ndarray, float]] = {}
+
+    def slot(d: int, prev: int) -> tuple[np.ndarray, float]:
+        key = (d, prev if d else -1)
+        if key in memo:
+            return memo[key]
+        bias = r.mb0[i] if d == 0 else r.mbs[i, d - 1, prev]
+        score = (r.vals[i, d] + bias) / temp
+        pick = score + weight * r.noise[i, d] if sampled else score
+        if sampled and use_filter:
+            pick = np.where(target_kept(score, r.cand[i, d], r.sampling), pick, -np.inf)
+        if m["learned_conf"]:
+            z = float(r.hconf[i, d]) + m["conf_b"] + (float(r.cm0[i]) if d == 0 else float(r.cms[i, d - 1, prev]))
+            c = float(1.0 / (1.0 + np.exp(-z)))
+        else:
+            e = np.exp(score - score.max())
+            c = float(e[int(np.argmax(pick))] / e.sum())
+        memo[key] = (pick, c)
