+def route_reference(pick: torch.Tensor, E: int, item_rows: int = 64) -> tuple[list[tuple[int, int, int]], list[set]]:
+    """What ``ext.route`` writes, on the host: the items (expert, first sorted position, rows) in expert order, an
+    expert's pairs in items of ``item_rows`` (the kernel's BM), and each expert's pairs (r * slots + s) as a set (the
+    kernel's scatter places an expert's pairs in any order within its span: each pair's output row is its own, so
+    the order changes no bit). Only per-expert counts are kept on the device, so any number of rows is one call."""
+
+    flat = pick.reshape(-1).to(torch.int64).cpu()
+    items, spans, pos = [], [], 0
+    for e in range(E):
+        idx = torch.nonzero(flat == e).flatten().tolist()
+        for j in range(0, len(idx), item_rows):
+            items.append((e, pos + j, min(item_rows, len(idx) - j)))
+        spans.append(set(idx))
+        pos += len(idx)
+    return items, spans
+
