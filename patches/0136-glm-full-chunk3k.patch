+def group_reference(pick: torch.Tensor, E: int, maxm: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """What the grouping kernel (``ext.group``) writes, on the host: the distinct experts < E of ``pick`` [R, slots]
+    in id order, and each one's members row * 32 + slot in pair order (row-major), at most ``maxm``, -1 after the
+    last ([count, maxm]); for tests (the kernel stages the picks in shared memory or reads them from global memory
+    by the chunk's size, the same members in the same order either way)."""
+
+    R, S = pick.shape
+    flat = pick.reshape(-1).to(torch.int64).cpu()
+    uids = [e for e in range(E) if bool((flat == e).any())]
+    members = torch.full((len(uids), maxm), -1, dtype=torch.int32)
+    for k, e in enumerate(uids):
+        idx = torch.nonzero(flat == e).flatten()[:maxm]
+        members[k, :len(idx)] = ((idx // S) * 32 + idx % S).to(torch.int32)
+    return torch.tensor(uids, dtype=torch.int32), members
+
