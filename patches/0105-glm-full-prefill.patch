+    if (a.mt > 1) { grouped_mt_launch<CB>(a, stream); return; }
     const int MT = (a.maxm + 15) / 16;
     dim3 grid((unsigned)a.nexp_max, (unsigned)(a.N / (16 * a.nt)), (unsigned)(a.mats * a.SK * MT));
 #define TF_LAUNCH(NT_, W_, PF_, LO_, HI_)                                                                       \
