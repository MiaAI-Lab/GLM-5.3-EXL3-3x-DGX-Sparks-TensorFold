+// grouped_kernel for prompt chunks (full GLM-5.3, mixed widths): a program takes up to MTL member tiles of 16 of
+// one expert (MTL x 16 rows) and decodes each trellis tile once for all of them (the decode, not the mma, bounds the
+// one-tile kernel on prompt chunks). Every row's sums are grouped_kernel's: the same k tiles a warp in the same order
+// (the same SK and W), each tile's two mma on that row's A fragment, warps added in order through shared memory a
+// member tile at a time, so the same bits.
+template <int CB, int K2, int NT, int PF, int MTL>
+__device__ __forceinline__ void warp_tiles_mt(const uint32_t* __restrict__ T, int NTILES, int kt0, int nkt, int nt0,
+                                              const half* (&x0)[MTL], const half* (&x1)[MTL], const bool (&ok0)[MTL],
+                                              const bool (&ok1)[MTL], int nact, int lane, float (&acc)[MTL][NT][2][4]) {
+    constexpr int TW = Fmt<K2>::TW, LW = Fmt<K2>::LW;
+    const LaneMap<K2> map(lane);
+    const size_t kstride = (size_t)NTILES * TW;
+    const uint32_t* tp = T + ((size_t)kt0 * NTILES + nt0) * TW + lane;
+    uint32_t pf[PF][NT][LW];
+#pragma unroll
+    for (int d = 0; d < PF; ++d)
+        if (d < nkt)
+#pragma unroll
+            for (int i = 0; i < NT; ++i) load_words<K2>(pf[d][i], tp + d * kstride + i * TW, lane);
+    for (int ib = 0; ib < nkt; ib += PF) {
+#pragma unroll
+        for (int d = 0; d < PF; ++d) {
+            const int it = ib + d;
+            if (it < nkt) {
+                uint32_t w[NT][LW];
+#pragma unroll
+                for (int i = 0; i < NT; ++i)
+#pragma unroll
+                    for (int l = 0; l < LW; ++l) w[i][l] = pf[d][i][l];
+                if (it + PF < nkt)
+#pragma unroll
+                    for (int i = 0; i < NT; ++i)
+                        load_words<K2>(pf[d][i], tp + (size_t)(it + PF) * kstride + i * TW, lane);
+                const int k = (kt0 + it) * 16;
+                uint32_t a[MTL][4];
+#pragma unroll
+                for (int m = 0; m < MTL; ++m)
+                    if (m < nact) {
+                        a[m][0] = load_pair(x0[m] + k, ok0[m]);
+                        a[m][1] = load_pair(x1[m] + k, ok1[m]);
+                        a[m][2] = load_pair(x0[m] + k + 8, ok0[m]);
+                        a[m][3] = load_pair(x1[m] + k + 8, ok1[m]);
+                    }
+#pragma unroll
+                for (int i = 0; i < NT; ++i) {
+                    uint32_t b0[2], b1[2];
+                    decode_tile<CB, K2>(w[i], map, lane, b0, b1);
+#pragma unroll
+                    for (int m = 0; m < MTL; ++m)
+                        if (m < nact) {
+                            mma16816(acc[m][i][0], a[m], b0);
+                            mma16816(acc[m][i][1], a[m], b1);
+                        }
+                }
+            }
+        }
+    }
+}
+
+template <int CB, int NT, int W, int PF, int LO, int HI, int MTL>
+__global__ void __launch_bounds__(W * 32) grouped_mt_kernel(
+    const half* __restrict__ X0, const half* __restrict__ X1, const int64_t* __restrict__ TP0,
+    const int64_t* __restrict__ TP1, const int* __restrict__ K2_0, const int* __restrict__ K2_1,
+    const int* __restrict__ uids, const int* __restrict__ ucount, const int* __restrict__ members,
+    float* __restrict__ Z, int K, int N, int P, int SK, int maxm, int slots) {
+    const int u = blockIdx.x;
+    if (u >= ucount[0]) return;
+    const int MT = (maxm + 16 * MTL - 1) / (16 * MTL);
+    const int mgroup = blockIdx.z % MT;
+    const int split = (blockIdx.z / MT) % SK;
+    const int mat = blockIdx.z / MT / SK;
+    const half* X = mat ? X1 : X0;
+    const int e = uids[u];
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(mat ? TP1[e] : TP0[e]);
+    const int k2 = mat ? K2_1[e] : K2_0[e];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, t = lane & 3;
+    const int KT = K >> 4, NTILES = N >> 4;
+
+    __shared__ int rows_sh[16 * MTL];
+    for (int i = threadIdx.x; i < 16 * MTL; i += W * 32) {
+        const int m = mgroup * 16 * MTL + i;
+        const int code = m < maxm ? members[u * maxm + m] : -1;
+        rows_sh[i] = code >= 0 ? (code >> 5) * slots + (code & 31) : -1;
+    }
+    __syncthreads();
+    if (rows_sh[0] < 0) return;
+    int nact = 0;                                     // member tiles holding rows (members come first)
+#pragma unroll
+    for (int m = 0; m < MTL; ++m) nact += rows_sh[m * 16] >= 0;
+    const half* x0[MTL];
+    const half* x1[MTL];
+    bool ok0[MTL], ok1[MTL];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m) {
+        const int r0 = rows_sh[m * 16 + g], r1 = rows_sh[m * 16 + g + 8];
+        ok0[m] = r0 >= 0;
+        ok1[m] = r1 >= 0;
+        x0[m] = X + (size_t)(r0 < 0 ? 0 : r0) * K + 2 * t;
+        x1[m] = X + (size_t)(r1 < 0 ? 0 : r1) * K + 2 * t;
+    }
+    const int per_split = KT / SK, per_warp = per_split / W;
+    const int kt0 = split * per_split + warp * per_warp;
+    const int nt0 = blockIdx.y * NT;
+
+    float acc[MTL][NT][2][4];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m)
+#pragma unroll
+        for (int i = 0; i < NT; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[m][i][h][c] = 0.f;
+
+    switch (k2) {
+#define TF_EXL3X_MT_CASE(K2_)                                                                                   \
+    case K2_:                                                                                                   \
+        if constexpr (K2_ >= LO && K2_ <= HI)                                                                   \
+            warp_tiles_mt<CB, K2_, NT, PF, MTL>(T, NTILES, kt0, per_warp, nt0, x0, x1, ok0, ok1, nact, lane, acc); \
+        else                                                                                                    \
+            __trap();                                                                                           \
+        break;
+        TF_EXL3X_MT_CASE(2)
+        TF_EXL3X_MT_CASE(3)
+        TF_EXL3X_MT_CASE(4)
+        TF_EXL3X_MT_CASE(5)
+        TF_EXL3X_MT_CASE(6)
+        TF_EXL3X_MT_CASE(7)
+        TF_EXL3X_MT_CASE(8)
+        TF_EXL3X_MT_CASE(9)
+        TF_EXL3X_MT_CASE(10)
+        TF_EXL3X_MT_CASE(11)
+        TF_EXL3X_MT_CASE(12)
+        TF_EXL3X_MT_CASE(13)
+        TF_EXL3X_MT_CASE(14)
+        TF_EXL3X_MT_CASE(15)
+        TF_EXL3X_MT_CASE(16)
+#undef TF_EXL3X_MT_CASE
+        default:
+            __trap();
+    }
+
+    // a member tile at a time: grouped_kernel's reduction (warps in order) on its 16 rows
+    __shared__ float red[W][16][NT * 16];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m) {
+        if (m >= nact) break;
+#pragma unroll
+        for (int i = 0; i < NT; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int col = i * 16 + h * 8 + 2 * t;
+                red[warp][g][col] = acc[m][i][h][0];
+                red[warp][g][col + 1] = acc[m][i][h][1];
+                red[warp][g + 8][col] = acc[m][i][h][2];
+                red[warp][g + 8][col + 1] = acc[m][i][h][3];
+            }
+        __syncthreads();
+        for (int idx = threadIdx.x; idx < 16 * NT * 16; idx += W * 32) {
+            const int row = idx / (NT * 16), col = idx % (NT * 16);
+            const int r = rows_sh[m * 16 + row];
+            if (r < 0) continue;
+            float s = red[0][row][col];
+#pragma unroll
+            for (int w = 1; w < W; ++w) s += red[w][row][col];
+            Z[(((size_t)mat * SK + split) * P + r) * N + nt0 * 16 + col] = s;
+        }
+        __syncthreads();
+    }
+}
+
 // W_q [K, N] fp16 of one matrix through the same lane decode (tests; not on the forward path).
 template <int CB, int K2>
 __global__ void dequant_kernel(const uint32_t* __restrict__ T, half* __restrict__ out, int K, int N) {
@@ -319,10 +491,37 @@ struct GroupedArgs {
     int K, N, P, SK, maxm, slots;
     int nexp_max;        // grid.x (upper bound of distinct experts)
     int mats, nt, warps, pf, lo, hi;
+    int mt = 1;          // member tiles a program (> 1: grouped_mt_kernel, prompt chunks)
 };
 
+template <int CB, int MTL>
+void grouped_mt_run(const GroupedArgs& a, cudaStream_t stream) {
+    const int MT = (a.maxm + 16 * MTL - 1) / (16 * MTL);
+    dim3 grid((unsigned)a.nexp_max, (unsigned)(a.N / (16 * a.nt)), (unsigned)(a.mats * a.SK * MT));
+#define TF_LAUNCH_MT(NT_, W_, PF_, LO_, HI_)                                                                    \
+    grouped_mt_kernel<CB, NT_, W_, PF_, LO_, HI_, MTL><<<grid, W_ * 32, 0, stream>>>(                           \
+        a.x0, a.x1, a.tp0, a.tp1, a.k2_0, a.k2_1, a.uids, a.ucount, a.members, a.z, a.K, a.N, a.P, a.SK, a.maxm, \
+        a.slots)
+#define TF_RANGES_MT(NT_, W_, PF_)                                                                              \
+    if (a.lo >= 2 && a.hi <= 10) TF_LAUNCH_MT(NT_, W_, PF_, 2, 10);                                             \
+    else TF_LAUNCH_MT(NT_, W_, PF_, 2, 16);
+    if (a.nt == 8 && a.warps == 4 && a.pf == 1) { TF_RANGES_MT(8, 4, 1) }
+    else if (a.nt == 4 && a.warps == 4 && a.pf == 1) { TF_RANGES_MT(4, 4, 1) }
+    else TORCH_CHECK(false, "unsupported multi-tile setting nt=", a.nt, " warps=", a.warps, " pf=", a.pf);
+#undef TF_RANGES_MT
+#undef TF_LAUNCH_MT
+}
+
+template <int CB>
+void grouped_mt_launch(const GroupedArgs& a, cudaStream_t stream) {
+    if (a.mt == 2) grouped_mt_run<CB, 2>(a, stream);
+    else if (a.mt == 4) grouped_mt_run<CB, 4>(a, stream);
+    else TORCH_CHECK(false, "member tiles a program: 1, 2 or 4, not ", a.mt);
+}
+
