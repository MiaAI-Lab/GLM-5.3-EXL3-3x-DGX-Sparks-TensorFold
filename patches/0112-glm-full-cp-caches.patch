+    selection and attention scratch of either kind of window. ``cp`` > 1 (context parallelism): a rank keeps
+    ceil(capacity / cp) + 1 token rows and scores only those, plus the exchange buffers (``full_cp_bytes``)."""
 
     def bytes_at(capacity: int) -> int:
         b = full_buffer_bytes(t, decode_rows, world=world, share=share, capacity=capacity, prefill=False,
@@ -418,9 +435,12 @@ def mla_full_geometry(t: dict, world: int, reserve: int, *, share, decode_rows:
                                    prompt_split_k=prompt_split_k)
         b += full_buffer_bytes(t, prefill_rows, world=world, share=share, capacity=capacity, prefill=True,
                                prompt_split_k=prompt_split_k)
-        b += max(full_transient_bytes(t, prefill_rows, capacity, prefill=True, share=share),
-                 full_transient_bytes(t, decode_rows, capacity, prefill=False, share=share))
-        return b + capacity * full_token_bytes(t, kv, mtp)
+        local = -(-capacity // cp) + (1 if cp > 1 else 0)
+        b += max(full_transient_bytes(t, prefill_rows, local, prefill=True, share=share)
+                 + full_cp_bytes(t, prefill_rows, cp, prefill=True, share=share),
+                 full_transient_bytes(t, decode_rows, local, prefill=False, share=share)
+                 + full_cp_bytes(t, decode_rows, cp, prefill=False, share=share))
+        return b + local * full_token_bytes(t, kv, mtp)
     return Geometry(bytes_at, reserve, minimum_slots)
 
 
