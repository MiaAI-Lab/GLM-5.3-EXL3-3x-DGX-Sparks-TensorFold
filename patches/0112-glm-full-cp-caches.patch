+def full_cp_bytes(t: dict, rows: int, cp: int, *, prefill: bool, share) -> int:
+    """Context parallelism (TF_GLM_CP, ``cp`` ranks each holding every cp-th token): a window's exchange buffers on a
+    rank: the candidates of every rank [cp, rows, topk] int64, every rank's absorbed queries of every head [rows,
+    heads, 512 + 64] bf16 and the partial outputs and log-sum-exps [cp, rows, heads, 512 + 1] fp32 (a prompt chunk's
+    in blocks of CP_PROMPT_ROWS rows)."""
+    if cp <= 1:
+        return 0
+    heads = int(t["num_attention_heads"])
+    lw, rope, topk = int(t["kv_lora_rank"]), int(t["qk_rope_head_dim"]), int(t.get("index_topk", 2048))
+    r = min(rows, CP_PROMPT_ROWS) if prefill else rows
+    return cp * rows * topk * 8 + r * heads * (lw + rope) * 2 + cp * r * heads * (lw + 1) * 4
+
+
+CP_PROMPT_ROWS = 512        # context parallelism: a prompt chunk's rows a sparse attention exchange takes
+
+
 def mla_full_geometry(t: dict, world: int, reserve: int, *, share, decode_rows: int, mtp_rows: int,
