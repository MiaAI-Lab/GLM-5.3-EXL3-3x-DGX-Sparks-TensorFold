+// prompt with each row's per-head log-sum-exp (fp32 [R, H]) too, and rows without tokens written as 0 / -inf: a
+// context-parallel rank's partial over its own tokens
+void prompt_lse(const at::Tensor& qa, const at::Tensor& qp, const at::Tensor& cache, const at::Tensor& rope,
+                const at::Tensor& tokens, const at::Tensor& counts, at::Tensor out, at::Tensor lse, double scale) {
+    TORCH_CHECK(lse.is_cuda() && lse.scalar_type() == at::kFloat && lse.is_contiguous() && lse.dim() == 2 &&
+                    lse.size(0) == qa.size(0) && lse.size(1) == qa.size(1),
+                "msa: a contiguous fp32 [R, H] lse");
+    auto ok = [](const at::Tensor& x, at::ScalarType t) { return x.is_cuda() && x.scalar_type() == t && x.is_contiguous(); };
+    TORCH_CHECK(ok(qa, at::kBFloat16) && ok(qp, at::kBFloat16) && ok(rope, at::kBFloat16) && ok(out, at::kBFloat16) &&
+                    ok(cache, at::kByte) && ok(tokens, at::kInt) && ok(counts, at::kInt) && out.sizes() == qa.sizes(),
+                "msa: shapes and types as prompt");
+    c10::cuda::CUDAGuard guard(qa.device());
+    msa_prompt_cuda(qa, qp, cache, rope, tokens, counts, out, lse.data_ptr<float>(), scale);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("prompt", &prompt);
+    m.def("prompt_lse", &prompt_lse);
+}
