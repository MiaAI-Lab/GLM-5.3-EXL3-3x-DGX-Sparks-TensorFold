+# -- several streams' rows in one launch (multi-stream verify windows) --------------------------------------------
+# A window of several streams' rows back to back, each stream's per-token caches in its own extent of shared planes:
+# per-row device tables (``full_seg.FullRows``: position in the stream ``pos``, extent base ``base``, extent capacity
+# ``cap``) replace the single-stream kernels' one position (POS[0] + r). Each row keeps its single-stream kernel's
+# arithmetic (the same functions, tiles and masks), so it gets the bits of its stream's window run alone; the caches
+# passed are the whole planes (a stream's token t at row base + t).
+
+def q_rope_rows(q: torch.Tensor, out: torch.Tensor, pos: torch.Tensor, freq: torch.Tensor, offset: int) -> torch.Tensor:
+    """``q_rope`` with each row at its own position ``pos`` [>= R] (device int32)."""
+
+    R, H = q.shape[0], q.shape[1]
+    half = freq.numel()
+    if out.shape[0] < R or out.shape[1] != H or out.shape[2] != 2 * half or not out.is_contiguous():
+        raise ValueError(f"q_rope_rows: out {tuple(out.shape)} for {R} rows of {H} heads, {2 * half} rotary dims")
+    if q.stride(2) != 1 or pos.numel() < R:
+        raise ValueError("q_rope_rows: a head's dims contiguous, a position a row")
+    if R:
+        _q_rope[(R, H)](q, q.stride(0), q.stride(1), out, pos, freq, H=H, OFF=int(offset), HALF=half, SEG=1,
+                        num_warps=1)
+    return out
+
+
+def index_q_rope_rows(qi: torch.Tensor, heads: int, pos: torch.Tensor, freq: torch.Tensor) -> torch.Tensor:
+    """``index_q_rope`` with each row at its own position ``pos`` [>= R] (device int32), in place."""
+
+    R = qi.shape[0]
+    D = qi.shape[1] // heads
+    if qi.stride(1) != 1 or qi.dtype != torch.bfloat16 or 2 * freq.numel() > D or pos.numel() < R:
+        raise ValueError("index_q_rope_rows: bf16 rows of heads x dims, unit stride, a position a row")
+    if R:
+        _qi_rope[(R, heads)](qi, qi.stride(0), pos, freq, D=D, HALF=freq.numel(), SEG=1, num_warps=1)
+    return qi
+
+
+def k_rope_write_rows(k: torch.Tensor, plane: torch.Tensor, pos: torch.Tensor, base: torch.Tensor,
+                      freq: torch.Tensor, latent: torch.Tensor | None = None) -> None:
+    """``k_rope_write`` with row r rotated at pos[r] into plane row base[r] + pos[r] (its stream's extent).
+    TF_GLM_KV=fp4x: the plane's e4m3 codes, each row's scale into ``latent`` (the layer's FP4 latent plane) at the
+    same row, as ``k_rope_write``."""
+
+    half = freq.numel()
+    if k.shape[1] < 2 * half or k.stride(1) != 1 or plane.dtype not in (torch.bfloat16, torch.uint8) \
+            or plane.shape[1] != 2 * half:
+        raise ValueError(f"k_rope_write_rows: rows of {k.shape[1]} into a plane of {tuple(plane.shape)}")
+    KR, LS, LRS, RSW, R8 = rope8_args(plane, latent)
+    if R8:
+        KR = plane                       # code bytes (kv8.e4m3_code), as k_rope_write
+    if k.shape[0]:
+        _k_rope_write[(k.shape[0],)](k, k.stride(0), KR, pos, base, freq, 0, HALF=half, SEG=True, LS=LS, LRS=LRS,
+                                     RSW=RSW, R8=R8, num_warps=1)
+
+
+def index_write_rows(k_raw: torch.Tensor, ln_w: torch.Tensor, ln_b: torch.Tensor, plane: torch.Tensor,
+                     pos: torch.Tensor, base: torch.Tensor, freq: torch.Tensor, eps: float = 1e-6) -> None:
+    """``index_write`` with row r's key (rotated at pos[r]) into plane row base[r] + pos[r]. TF_GLM_KV=fp4x: as
+    ``index_write``, two passes: the bf16 kernel's rows into a scratch [R, D] (OUTR), then ``kv8.quant_rows8`` to
+    rows base[r] + pos[r] (the one encoder: the bytes of the single-stream write)."""
+
+    D = kv8.index_width(plane)
+    if plane.dtype not in (torch.bfloat16, torch.uint8) or not plane.is_contiguous() or k_raw.stride(1) != 1 \
+            or k_raw.shape[1] < D:
+        raise ValueError("index_write_rows: bf16 (or fp4x) key rows, contiguous")
+    R = k_raw.shape[0]
+    if not R:
+        return
+    if not kv8.index8(plane):
+        _index_write[(R,)](k_raw, k_raw.stride(0), ln_w, ln_b, plane, pos, freq, float(eps), 0, D=D,
+                           HALF=freq.numel(), BASE=base, SEG=1, num_warps=1)
+        return
+    rows = torch.empty((R, D), dtype=torch.bfloat16, device=plane.device)
+    _index_write[(R,)](k_raw, k_raw.stride(0), ln_w, ln_b, rows, pos, freq, float(eps), 0, D=D, HALF=freq.numel(),
+                       OUTR=1, BASE=base, SEG=1, num_warps=1)
+    kv8.quant_rows8(rows, plane, plane.view(torch.float32), pos, rs=D + 4, srs=(D + 4) // 4, sw=D // 4, base=base)
+
+
+@triton.jit
+def _scores_rows(QI, W, w_stride, KEYS, OUT, o_stride, POS, BASE, CAP, NT, scale, wscale, K: tl.constexpr,
+                 H: tl.constexpr, HP: tl.constexpr, D: tl.constexpr, BTT: tl.constexpr, G: tl.constexpr, KS=None,
+                 K8: tl.constexpr = 0):
+    """Program (row, g): _scores (RB = 1) for a row of its own stream: its keys from KEYS row BASE[r], visible
+    through POS[r]; token blocks g, g + G, .. of the NP = min(NT, CAP[r], max(POS[r] + 1, K)) columns its selection
+    reads (-inf past its position). Each block's dot is _scores' [HP, BTT] tile with its masks, so every score has
+    the lone window's bits (K8, TF_GLM_KV=fp4x: ``key_tile``'s exact bf16 rows from the e4m3 codes and scales)."""
+    r = tl.program_id(0)
+    g = tl.program_id(1)
+    P = tl.load(POS + r)
+    B = tl.load(BASE + r).to(tl.int64)
+    n = P + 1
+    NP = tl.minimum(tl.minimum(NT, tl.load(CAP + r)), tl.maximum(n, K))
+    d = tl.arange(0, D)
+    hh = tl.arange(0, HP)
+    hok = hh < H
+    nb = (NP + BTT - 1) // BTT
+    for tb in range(g, nb, G):
+        t = tb * BTT + tl.arange(0, BTT)
+        if tb * BTT >= n:
+            tl.store(OUT + r * o_stride + t, float("-inf"), mask=t < NP)
+        else:
+            k = key_tile(KEYS, KS, B + t.to(tl.int64), t < n, d, D, K8)                                 # [BTT, D]
+            q = tl.load(QI + (r * H + hh[:, None]) * D + d[None, :], mask=hok[:, None], other=0.0).to(tl.bfloat16)
+            kr = tl.where((t < n)[:, None], k, 0.0)
+            dots = tl.dot(q, tl.trans(kr))                                                            # [HP, BTT]
+            w = tl.load(W + r * w_stride + hh, mask=hok, other=0.0).to(tl.float32) * wscale
+            sc = tl.sum(w[:, None] * tl.maximum(dots * scale, 0.0), axis=0)
+            tl.store(OUT + r * o_stride + t, tl.where(t < n, sc, float("-inf")), mask=t < NP)
+
+
+def rows_bucket(vis_max: int, cap_max: int) -> int:
+    """Token columns a window of several streams scores (``bucket`` over its rows: the longest visible context
+    rounded up to a power of two, at least MIN_BUCKET, at most the largest extent): one of ``buckets(cap_max)``, the
+    CUDA graphs' second key beside the row count."""
+    return min(int(cap_max), max(MIN_BUCKET, 1 << (int(vis_max) - 1).bit_length()))
+
+
+def score_rows(qi: torch.Tensor, wts: torch.Tensor, plane: torch.Tensor, pos: torch.Tensor, base: torch.Tensor,
+               cap: torch.Tensor, R: int, NT: int, out: torch.Tensor, k: int = TOPK) -> torch.Tensor:
+    """fp32 scores of R rows, each over its own stream's keys (plane rows base[r] ..) through pos[r]: out[r, :NP_r]
+    with NP_r = min(NT, cap[r], max(pos[r] + 1, k)) (the columns ``select_rows`` reads; the rest untouched)."""
+
+    H = wts.shape[1]
+    D = kv8.index_width(plane)
+    if qi.shape[1] != H * D or not qi.is_contiguous() or wts.stride(1) != 1 \
+            or plane.dtype not in (torch.bfloat16, torch.uint8) or not plane.is_contiguous():
+        raise ValueError("index scores: contiguous index queries [R, H * D], unit-stride weights, bf16 (or fp4x) keys")
+    KEYS, KS, K8 = key_args(plane)
+    if out.shape[1] < NT or out.stride(1) != 1:
+        raise ValueError(f"score_rows: {NT} columns into scores of {tuple(out.shape)}")
+    if R:
+        g = min(ROW_G, triton.cdiv(NT, BT))
+        _scores_rows[(R, g)](qi, wts, wts.stride(0), KEYS, out, out.stride(0), pos, base, cap, int(NT), D ** -0.5,
+                             _wscale(H), K=int(k), H=H, HP=max(16, triton.next_power_of_2(H)), D=D, BTT=BT, G=g,
+                             KS=KS, K8=K8, num_warps=4)
+    return out
+
+
+def select_rows(scores: torch.Tensor, pos: torch.Tensor, cap: torch.Tensor, R: int, NT: int, tokens: torch.Tensor,
+                counts: torch.Tensor, k: int = TOPK) -> None:
+    """``select`` for rows of several streams: row r's k best of its first min(NT, cap[r], max(pos[r] + 1, k))
+    scores, ascending stream-local tokens (ties to the lower one), counts k for rows that see more than k tokens."""
+
+    if R == 0:
+        return
+    if k > MIN_BUCKET:
+        raise ValueError(f"select_rows: top-{k} past the smallest bucket {MIN_BUCKET}")
+    block, warps = (4096, 8) if NT > 1024 else (1024, 4)
+    _select[(R,)](scores, scores.stride(0), tokens, counts, pos, int(NT), K=k, BLOCK=block, CAP=cap, SEG=1,
+                  num_warps=warps)
+
+
+def select_tokens_rows(qi: torch.Tensor, wts: torch.Tensor, plane: torch.Tensor, pos: torch.Tensor,
+                       base: torch.Tensor, cap: torch.Tensor, R: int, NT: int, scores: torch.Tensor,
+                       tokens: torch.Tensor, counts: torch.Tensor, k: int = TOPK) -> tuple[torch.Tensor, torch.Tensor]:
+    """The DSA selection of R rows of several streams (``select_tokens`` of a decode window, a row at a time over
+    its own stream): tokens[:R] [R, k] int32 (stream-local, ascending) and counts[:R]. ``NT``: the window's bucket
+    (``rows_bucket``), at least every row's columns; ``scores`` [>= R, >= NT] fp32 scratch."""
+
+    score_rows(qi, wts, plane, pos, base, cap, R, NT, scores, k)
+    select_rows(scores, pos, cap, R, NT, tokens, counts, k)
+    return tokens[:R], counts[:R]
+
+
