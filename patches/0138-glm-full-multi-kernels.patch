+
+class FullSegVerify(FullBatchedVerify):
+    """``FullBatchedVerify`` (the same ``forward`` / ``commit``, the same bits) with each layer's attention on every
+    segment's rows at once (``dsa_full_seg_rows``) instead of a call per segment: the window's tables staged once a
+    forward (``FullRows``), the selection's scratch static (``RowsScratch``). Eager; the launches are those a CUDA
+    graph keyed (R, NT) would capture. ``capacity``: the largest extent a stream may hold (default the pool's
+    rows)."""
+
+    def __init__(self, e, *, taps: Sequence[int] = (), rows: int | None = None, capacity: int | None = None) -> None:
+        from .verify import FULL_MAX_ROWS
+
+        super().__init__(e, taps=taps, rows=FULL_MAX_ROWS if rows is None else rows)
+        w = self.w
+        self.meta = FullRows(self.rows_max, w.device)
+        cap = int(e.caches.rows if capacity is None else capacity)
+        self.sel = (RowsScratch(self.rows_max, cap, w.cfg.index_topk, w.device) if e.caches.index is not None
+                    else None)
+        self.NT = 0
+        self.seg_topk = None
+
+    @torch.no_grad()
+    def forward(self, segments: Sequence[Segment]) -> Verified:
+        self._check(segments)
+        c = self.w.cfg
+        st0 = segments[0].st
+        self.indexed = st0.index is not None
+        self.meta.set([(s.st.base, s.st.pos, len(s.tokens), s.st.capacity) for s in segments],
+                      dense_limit=c.dense_limit, indexed=self.indexed)
+        self.NT = self.meta.bucket(self.sel.capacity if self.sel is not None else None) if self.indexed else 0
+        self.dsa_index, self.index_of = st0.dsa_index, st0.index_of
+        self.seg_topk = None
+        return super().forward(segments)
+
+    def _mixer(self, layer):
+        from .forward import dsa_full_front, dsa_full_out
+
+        if layer.kind != "dsa":
+            raise ValueError(f"layer {layer.index}: full GLM-5.3 has attention layers only")
+        w, b, R = self.w, self.b, self.R
+        with prof.timed("dsa (total)"):
+            dsa_full_front(layer, w, b, 0, R)
+            lc, kr, keys = planes(self.e.caches, layer.index, self.dsa_index, self.index_of)
+            self.seg_topk = dsa_full_seg_rows(layer, w, b, self.meta, R, lc, kr, keys, self.NT, self.sel,
+                                              self.seg_topk, indexed=self.indexed)
+            return dsa_full_out(layer, w, b, R)
