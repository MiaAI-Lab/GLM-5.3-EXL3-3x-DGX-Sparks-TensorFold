@@ -0,0 +1,230 @@
+"""Full GLM-5.3's multi-stream attention in one launch per piece (multi-stream milestone 3, the kernel layer).
+
+A verify window of several streams' rows back to back ([s1: rows][s2: rows]...; ``verify.FullBatchedVerify``), each
+stream's caches in its own extent of the shared ``forward.Caches`` planes (non-CP: a stream's token t at plane row
+base + t of every latent, rotary and index plane). ``FullRows`` holds per row, on the device, its position in its
+stream, its extent's base and capacity, and whether it attends sparsely; ``dsa_full_seg_rows`` then runs one layer's
+attention between ``forward.dsa_full_front`` and ``forward.dsa_full_out`` for ALL rows with one launch per piece:
+
+- cache writes (latents, rotary keys, index keys) at base[r] + pos[r] (``latent.latent_write_rows``,
+  ``dsa_full.k_rope_write_rows`` / ``index_write_rows``), query and indexer-query RoPE at pos[r]
+  (``dsa_full.q_rope_rows`` / ``index_q_rope_rows``);
+- the selection (full indexer layers): each row scores its own stream's index keys through its position and
+  selects its top-k, stream-local tokens with ties to the lower one (``dsa_full.select_tokens_rows``); a single
+  selection [R, k] carries through the shared indexer layers (each row its own);
+- dense and sparse latent attention with the rotary plane in one chunk pass and one merge
+  (``latent.attention_rows``).
+
+Bits: every per-row kernel is its single-stream kernel's code with the row's position / base read from the tables
+instead of POS[0] + r (the same functions, tiles, masks, accumulation order, launch widths), the row-independent ones
+(the indexer's projections, the absorb) are the lone window's on more rows (qmm and the absorb keep rows apart up to
+16), the selection reads exactly the columns a lone window's bucket reads (the rest are -inf either way), and the
+attention merges a row's chunks in the same order (chunks past its keys are empty, merged as nothing). So each
+stream's rows get the bits of its window run alone (``verify.FullBatchedVerify``'s per-segment loop;
+tests/cpu/test_multi_kernels.py).
+
+CUDA graphs: every launch's shape is a function of the window's total rows R and the selection's token bucket NT
+alone (``rows_bucket``; 0: no row is sparse, no selection), everything else is in device tables that ``FullRows.set``
+refreshes before a replay (pinned copy, ordered on the stream), and the scratch (``RowsScratch``: scores, token lists,
+counts) is static: a graph per (R, NT) serves every mix of streams, positions and extents. ``FullSegVerify`` is the
+eager verifier on these pieces (``FullBatchedVerify``'s interface)."""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+import torch
+
+from . import dsa_full, latent, prof
+from .verify import FullBatchedVerify, Segment, Verified
+
+
+class FullRows:
+    """Device tables of a window of up to ``rows`` rows (one int32 tensor [4, rows], a pinned host twin): per row
+    ``pos`` (its position in its stream), ``base`` (its stream's extent's first plane row), ``cap`` (the extent's
+    capacity: the tokens its selection may score) and ``sparse`` (1: attends to its selected tokens; 0: dense over
+    keys 0 .. pos). Rows past the window's R are left as they were (no launch reads them)."""
+
+    def __init__(self, rows: int, device) -> None:
+        self.rows = int(rows)
+        pin = torch.cuda.is_available() and torch.device(device).type == "cuda"
+        self.host = torch.zeros((4, self.rows), dtype=torch.int32, pin_memory=pin)
+        self.dev = torch.zeros((4, self.rows), dtype=torch.int32, device=device)
+        self.pos, self.base, self.cap, self.sparse = self.dev.unbind(0)
+        self.staged = torch.cuda.Event() if pin else None
+        self.R = 0
+        self.vis_max = 0
+        self.cap_max = 0
+        self.any_sparse = False
+
+    def fill(self, segments: Sequence[tuple[int, int, int, int]], *, dense_limit: int, indexed: bool):
+        """Host tables [4, rows] (numpy int32) and R for ``segments`` [(base, pos, rows, capacity)] in window order:
+        a row at position p is sparse when the engine has index caches and p >= ``dense_limit`` (full GLM-5.3's
+        top-k: exactly the rows that see more than k tokens)."""
+
+        R = sum(int(seg[2]) for seg in segments)
+        if not segments or R > self.rows:
+            raise ValueError(f"a window of {R} rows in {len(segments)} segments, the tables hold {self.rows}")
+        t = torch.zeros((4, self.rows), dtype=torch.int32).numpy()
+        r = 0
+        for k, (base, pos, n, cap) in enumerate(segments):
+            if n < 1 or pos < 0 or base < 0 or pos + n > cap:
+                raise ValueError(f"segment {k}: base {base}, position {pos}, {n} rows, capacity {cap}")
+            for i in range(n):
+                t[0, r + i] = pos + i
+                t[1, r + i] = base
+                t[2, r + i] = cap
+                t[3, r + i] = int(indexed and pos + i >= dense_limit)
+            r += n
+        return t, R
+
+    def set(self, segments: Sequence[tuple[int, int, int, int]], *, dense_limit: int, indexed: bool) -> int:
+        """Stage ``segments`` [(base, pos, rows, capacity)] into the device tables; returns the window's rows."""
+
+        t, R = self.fill(segments, dense_limit=dense_limit, indexed=indexed)
+        if self.staged is not None:
+            self.staged.synchronize()            # the previous copy has left the pinned buffer
+        self.host.numpy()[:] = t
+        self.dev.copy_(self.host, non_blocking=True)
+        if self.staged is not None:
+            self.staged.record()
+        self.R = R
+        self.vis_max = max(int(base_pos[1]) + int(base_pos[2]) for base_pos in segments)
+        self.cap_max = max(int(seg[3]) for seg in segments)
+        self.any_sparse = bool(t[3, :R].any())
+        return R
+
+    def bucket(self, capacity: int | None = None) -> int:
+        """The selection's token columns for the staged window (``dsa_full.rows_bucket`` of its longest visible
+        context, at most ``capacity``: default the largest staged extent), 0 when no row is sparse: with R the
+        CUDA graphs' key."""
+
+        if not self.any_sparse:
+            return 0
+        return dsa_full.rows_bucket(self.vis_max, self.cap_max if capacity is None else capacity)
+
+
+class RowsScratch:
+    """The selection's static buffers for windows of up to ``rows`` rows over extents of up to ``capacity`` tokens:
+    fp32 scores [rows, capacity], token lists [rows, k] int32, counts [rows] int32 (a graph's selection lands in
+    the same tensors every replay; the lists carry through the shared indexer layers)."""
+
+    def __init__(self, rows: int, capacity: int, k: int, device) -> None:
+        self.rows, self.capacity, self.k = int(rows), int(capacity), int(k)
