index 5db5f58..301dc69 100644
--- tensorfold/families/glm5_next/cuda/dcp.py
+++ tensorfold/families/glm5_next/cuda/dcp.py
@@ -345,3 +345,138 @@ def merge_ranks(o: torch.Tensor, lse: torch.Tensor, out: torch.Tensor | None = N
     if R:
         _merge_ranks[(R, H)](o, lse, out, R, G=G, H=H, LW=LW, num_warps=4)
     return out
+
+
+# -- prompt chunks: the selection merged by row owners, the partials merged straight from bf16 -------------------------
+
+def owner_rows(R: int, G: int) -> int:
+    """Rows of a prompt chunk each rank merges the selection of (``select_threshold``): rank p takes rows p M ..
+    min(R, (p + 1) M) - 1, M = ceil(R / G) (the exchanges take M rows a rank; the last ranks' rows past R are
+    padding)."""
+    return -(-int(R) // int(G))
+
+
+@triton.jit
+def _select_threshold(C, T, M, G: tl.constexpr, K: tl.constexpr, KP: tl.constexpr):
+    """Program m: T[m] = the K-th largest of the G K candidates C[g, m, :] (uint64 order, 0 when fewer than K are
+    real): _merge_select's radix select, the same passes on the same keys (C: [G, M, K], every rank's candidates of
+    the rows this rank merges), so the same threshold."""
+    m = tl.program_id(0).to(tl.int64)
+    j = tl.arange(0, KP)
+    jok = j < K
+    bins = tl.arange(0, 256)
+    prefix = tl.zeros((), dtype=tl.uint64)
+    fixed = tl.zeros((), dtype=tl.uint64)
+    need = K
+    for p in tl.static_range(8):
+        hist = tl.zeros((256,), dtype=tl.int32)
+        for g in tl.static_range(G):
+            u = tl.load(C + (g * M + m) * K + j, mask=jok, other=0).to(tl.uint64, bitcast=True)
+            match = jok & ((u & fixed) == prefix)
+            hist += tl.histogram(((u >> (56 - 8 * p)) & 0xFF).to(tl.int32), 256, mask=match)
+        at_or_above = tl.sum(hist, 0) - tl.cumsum(hist, 0) + hist
+        digit = tl.max(tl.where(at_or_above >= need, bins, 0), 0)
+        need -= tl.sum(tl.where(bins > digit, hist, 0), 0)
+        prefix = prefix | (digit.to(tl.uint64) << (56 - 8 * p))
+        fixed = fixed | (tl.full((), 0xFF, tl.uint64) << (56 - 8 * p))
+    tl.store(T + m, prefix.to(tl.int64, bitcast=True))
+
+
+@triton.jit
+def _select_keep(CAND, T, SL, CNT, G: tl.constexpr, K: tl.constexpr, KP: tl.constexpr):
+    """Program r: the rank's own candidates CAND[r] that are real and >= T[r] (uint64), in their (ascending position)
+    order, as local slots g // G -> SL[r] (int32, 0 past them), their number -> CNT[r]: _merge_select's keep."""
+    r = tl.program_id(0).to(tl.int64)
+    j = tl.arange(0, KP)
+    jok = j < K
+    prefix = tl.load(T + r).to(tl.uint64, bitcast=True)
+    u = tl.load(CAND + r * K + j, mask=jok, other=0).to(tl.uint64, bitcast=True)
+    keep = jok & (u >= prefix) & (u != 0)
+    kp = keep.to(tl.int32)
+    gpos = 4294967295 - u.to(tl.uint32).to(tl.int64)
+    at = tl.cumsum(kp, 0) - kp
+    n = tl.sum(kp, 0)
+    tl.store(SL + r * K + at, (gpos // G).to(tl.int32), mask=keep)
+    tl.store(SL + r * K + j, tl.zeros((KP,), tl.int32), mask=jok & (j >= n))
+    tl.store(CNT + r, n)
+
+
+def select_threshold(cands: torch.Tensor, m: int, out: torch.Tensor) -> torch.Tensor:
+    """cands [G, M, k] int64 (every rank's ``select_local`` candidates of the M rows this rank merges, rank order) ->
+    out[:m] int64 (uint64 bits): each row's k-th largest candidate, ``select_merge``'s threshold bit for bit (out[m:]
+    is left alone)."""
+    G, M, k = cands.shape
+    if not cands.is_contiguous() or cands.dtype != torch.int64 or out.dtype != torch.int64 or m > M:
+        raise ValueError("select_threshold: contiguous int64 candidates [G, M, k] and an int64 output")
+    if m:
+        _select_threshold[(int(m),)](cands, out, M, G=G, K=k, KP=triton.next_power_of_2(k),
+                                     num_warps=8 if k > 1024 else 4)
+    return out
+
+
+def select_keep(cand: torch.Tensor, thresholds: torch.Tensor, G: int, *, slots: torch.Tensor | None = None,
+                counts: torch.Tensor | None = None) -> tuple[torch.Tensor, torch.Tensor]:
+    """The rank's own candidates cand [R, k] and each row's threshold (``select_threshold`` of the row's owner) ->
+    (local slots [R, k] int32, counts [R] int32): ``select_merge``'s result bit for bit."""
+    R, k = cand.shape
+    if not cand.is_contiguous() or cand.dtype != torch.int64 or thresholds.numel() < R:
+        raise ValueError("select_keep: contiguous int64 candidates and a threshold a row")
+    slots = torch.empty((R, k), dtype=torch.int32, device=cand.device) if slots is None else slots
+    counts = torch.empty((R,), dtype=torch.int32, device=cand.device) if counts is None else counts
+    if R:
+        _select_keep[(R,)](cand, thresholds, slots, counts, G=int(G), K=k, KP=triton.next_power_of_2(k),
+                           num_warps=8 if k > 1024 else 4)
+    return slots, counts
+
+
+@triton.jit
+def _merge_ranks_bf16(OWN, OWN_L, GOT, GOT_L, OUT, n, RANK: tl.constexpr, G: tl.constexpr, HP: tl.constexpr,
+                      LW: tl.constexpr):
+    """Program (row, head): _merge_ranks on bf16 partials (each widened to fp32, exactly what merge_ranks gets from
+    ``got_o.float()``): rank RANK's own partial OWN [n, HP, LW] / OWN_L [n, HP], every other rank p's GOT[s] /
+    GOT_L[s] (s = p, or p - 1 past RANK), in rank order -> OUT[r, h] bf16 (OUT: [n, H, LW], H <= HP heads)."""
+    r = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1)
+    H = tl.num_programs(1)
+    k = tl.arange(0, LW)
+    M = float("-inf")
+    for g in tl.static_range(G):
+        if g == RANK:
+            x = tl.load(OWN_L + r * HP + h)
+        else:
+            s = g if g < RANK else g - 1
+            x = tl.load(GOT_L + (s * n + r) * HP + h)
+        M = tl.maximum(M, x)
+    acc = tl.zeros((LW,), tl.float32)
+    den = 0.0
+    for g in tl.static_range(G):
+        if g == RANK:
+            x = tl.load(OWN_L + r * HP + h)
+            o = tl.load(OWN + (r * HP + h) * LW + k).to(tl.float32)
+        else:
+            s = g if g < RANK else g - 1
+            x = tl.load(GOT_L + (s * n + r) * HP + h)
+            o = tl.load(GOT + ((s * n + r) * HP + h) * LW + k).to(tl.float32)
+        w = tl.where(x == float("-inf"), 0.0, tl.exp(x - M))
+        acc = acc + w * o
+        den = den + w
+    tl.store(OUT + (r * H + h) * LW + k, tl.where(den > 0.0, acc / tl.where(den > 0.0, den, 1.0), 0.0).to(tl.bfloat16))
+
+
+def merge_ranks_bf16(own: torch.Tensor, own_lse: torch.Tensor, got: torch.Tensor, got_lse: torch.Tensor, rank: int,
+                     out: torch.Tensor) -> torch.Tensor:
+    """``merge_ranks`` of bf16 partials without gathering them into one fp32 tensor: this rank's own partial of its
+    heads own [n, HP, LW] bf16 / own_lse [n, HP] fp32, the other ranks' got [G - 1, n, HP, LW] / got_lse [G - 1, n,
+    HP] (rank order, this rank left out) -> out [n, H, LW] bf16 (its first H <= HP heads: a rank's real heads), the
+    bits merge_ranks gives for the same partials (``got_o.float()``, rank order 0 .. G - 1)."""
+    n, HP, LW = own.shape
+    G = got.shape[0] + 1
+    H = out.shape[1]
+    if not all(t.is_contiguous() for t in (own, own_lse, got, got_lse, out)) or own.dtype != torch.bfloat16 \
+            or got.dtype != torch.bfloat16 or own_lse.dtype != torch.float32 or got_lse.dtype != torch.float32 \
+            or got.shape[1:] != own.shape or got_lse.shape != (G - 1, n, HP) or out.shape != (n, H, LW) or H > HP:
+        raise ValueError("merge_ranks_bf16: contiguous bf16 partials [n, HP, LW], fp32 lse, out [n, H <= HP, LW]")
+    if n and H:
+        _merge_ranks_bf16[(n, H)](own, own_lse, got, got_lse, out, n, RANK=int(rank), G=G, HP=HP, LW=LW,
+                                  num_warps=4)
+    return out
diff --git tensorfold/families/glm5_next/cuda/forward.py tensorfold/families/glm5_next/cuda/forward.py
