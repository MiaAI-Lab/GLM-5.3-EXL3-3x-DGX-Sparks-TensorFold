--- tensorfold/families/glm5_next/cuda/forward.py
+++ tensorfold/families/glm5_next/cuda/forward.py
@@ -955,6 +955,8 @@ def dsa_full_cp(layer: LayerW, w: Weights, lc: torch.Tensor, kr: torch.Tensor, p
     # or gather. Index keys are still written for later sparse rows.
     within = ((host_pos + R <= c.index_topk) if host_pos is not None else sparse_np is None) and \
         c.dense_limit <= c.index_topk
