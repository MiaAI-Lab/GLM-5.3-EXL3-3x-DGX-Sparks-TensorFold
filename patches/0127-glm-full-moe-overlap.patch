+                  f"fitted {np.mean(1 / (1 + np.exp(-(a * z[m] + b)))):.3f}, kept {np.mean(k[m]):.3f}")
+    if costs is not None:
+        for name, p in (("cost8 raw", Policy("c", most=8, costs=costs)),
+                        ("cost8 calibrated", Policy("c", most=8, costs=costs, conf_scale=a, conf_shift=b))):
+            agg = [walk(r, p, costs) for r in recs]
+            t, rd = sum(x["tokens"] for x in agg), sum(x["rounds"] for x in agg)
+            print(f"   {name:>18}: tokens/round {t / rd:.3f}, est. {1000.0 * t / sum(x['ms'] for x in agg):.1f} tok/s")
 
 
