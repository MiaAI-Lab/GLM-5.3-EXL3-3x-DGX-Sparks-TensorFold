+    sl, z, k = (np.concatenate([q[j] for q in pairs]) for j in range(3))
+    if not len(z):
+        return
+    a, b, before, rate = fit_confidence(sl, z, k.astype(np.float64))
+    print(f"   confidence: mean predicted {before:.3f} vs kept {rate:.3f} over {len(z)} slots; fitted scale {a:.3f} "
+          f"shift {b:.3f}")
+    for d in range(int(sl.max()) + 1):
+        m = sl == d
+        if m.sum() >= 20:
