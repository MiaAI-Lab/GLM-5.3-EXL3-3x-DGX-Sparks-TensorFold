+def confidence_pairs(r: Record, p: Policy) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """(slot, confidence logit, kept) for every slot of every record's full chain (all D slots walked), kept: the draft
+    equals the reply's token there given every earlier draft did (the verifier's conditional acceptance)."""
+
+    full = Policy("full", most=r.cand.shape[1], noise=p.noise, filter=p.filter, logit_scale=p.logit_scale)
+    slots, logits, kept = [], [], []
+    n = len(r.tokens) - 1
+    for i in range(len(r.cand)):
+        drafts = chain(r, i, full)
+        zs = _conf_logits(r, i, full)
+        for d, tok in enumerate(drafts):
+            if i + 1 + d > n:
+                break
+            slots.append(d)
+            logits.append(zs[d])
+            ok = tok == int(r.tokens[i + 1 + d])
+            kept.append(ok)
+            if not ok:
+                break
+    return np.array(slots), np.array(logits), np.array(kept)
+
+
+def _conf_logits(r: Record, i: int, p: Policy) -> list[float]:
+    """The learned confidence logits of the chain p proposes at record i (before scale/shift)."""
+
+    from .dspark import target_kept
+
+    m = r.meta
+    sampled = r.sampling is not None
+    temp = float(r.sampling.temperature) if sampled else 1.0
+    weight = m["dspark_noise"] if p.noise is None else p.noise
+    use_filter = m["dspark_filter"] if p.filter is None else p.filter
+    out, a = [], -1
+    for d in range(min(p.most, r.cand.shape[1])):
+        bias = r.mb0[i] if d == 0 else r.mbs[i, d - 1, a]
+        score = (r.vals[i, d] + bias) / temp
+        pick = p.logit_scale * score + weight * r.noise[i, d] if sampled else score
+        if sampled and use_filter:
+            pick = np.where(target_kept(score, r.cand[i, d], r.sampling), pick, -np.inf)
+        j = int(np.argmax(pick))
+        out.append(float(r.hconf[i, d]) + m["conf_b"] + (float(r.cm0[i]) if d == 0 else float(r.cms[i, d - 1, a])))
+        a = j
+    return out
+
+
+def fit_confidence(slots: np.ndarray, z: np.ndarray, kept: np.ndarray) -> tuple[float, float, float, float]:
+    """Logistic fit kept ~ sigmoid(a z + b) (Newton steps): (a, b, mean predicted before, mean kept)."""
+
+    a, b = 1.0, 0.0
+    for _ in range(50):
+        q = 1.0 / (1.0 + np.exp(-(a * z + b)))
+        g = np.array([np.sum((kept - q) * z), np.sum(kept - q)])
+        w = q * (1 - q)
+        h = np.array([[np.sum(w * z * z), np.sum(w * z)], [np.sum(w * z), np.sum(w)]]) + 1e-9 * np.eye(2)
+        step = np.linalg.solve(h, g)
+        a, b = a + step[0], b + step[1]
+        if np.abs(step).max() < 1e-10:
+            break
+    before = float(np.mean(1.0 / (1.0 + np.exp(-z))))
+    return float(a), float(b), before, float(np.mean(kept))
+
