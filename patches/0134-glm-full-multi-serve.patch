+def parallel_refusal(parallel: int, *, full: bool, drafter: bool, dspark: bool, serial_only: bool,
+                     cp: int = 1) -> str | None:
+    """Why --parallel ``parallel`` cannot start with these settings (before any connection or memory), or None.
+    ``full``: full GLM-5.3 (glm_moe_dsa); ``drafter``: a draft model was given (``dspark``: a DSpark speculator);
+    ``cp``: the ranks context parallelism (TF_GLM_CP=1) splits the caches over, 1 without it."""
+
+    if parallel <= 1:
+        return None
+    if cp > 1:
+        return (f"--parallel {parallel}: TF_GLM_CP=1 (context parallelism) serves one request at a time; concurrent "
+                "requests under context parallelism are not built yet: serve --parallel N with TF_GLM_CP=0, or "
+                "TF_GLM_CP=1 with --parallel 1")
+    if drafter or serial_only:
+        return None                  # a DFlash2 drafter on full GLM-5.3 is refused with the full checks
+    if full:
+        # the MTP head is not loaded under --parallel (``mtp_on``): its drafts are one request's at a time
+        return (f"--parallel {parallel}: full GLM-5.3's concurrent requests draft with a DSpark speculator only (its "
+                "MTP head drafts one request at a time, --parallel 1): give every rank the DSpark speculator "
+                "(--drafter), serve with --parallel 1 for MTP drafts, or pass --no-drafts to every rank to decode "
+                f"{parallel} requests together without drafts")
+    # this used to fail later as "TF_GLM_MTP=0 leaves no MTP head" whatever TF_GLM_MTP said (issue #38)
+    return (f"--parallel {parallel}: concurrent requests draft with DFlash2 only (the checkpoint's MTP head drafts "
+            "one request at a time, --parallel 1): give every rank the DFlash2 draft model (--drafter), serve with "
+            f"--parallel 1 for MTP drafts, or pass --no-drafts to every rank to decode {parallel} requests together "
+            "without drafts")
+
+
+def full_multi_bytes(t: dict, parallel: int, slots: int, *, world: int, share, kv: str, mtp: bool,
+                     prompt_split_k: bool) -> int:
+    """--parallel N on full GLM-5.3 (no context parallelism): what N streams add on a rank to the one-stream
+    geometry at ``slots`` cache slots A STREAM (the admitted window is each stream's; the pool holds N of them): the
+    other N - 1 streams' per-token caches (``geometry.full_token_bytes``; MLA's cache is the same on every rank)
+    and the batched verify window's own buffers (``verify.FullBatchedVerify``: FULL_MAX_ROWS decode rows over the
+    pool, ``geometry.full_buffer_bytes``). Its selection and attention scratch is a segment's at a time, no more
+    than a lone verify window's, which the one-stream geometry counts already. Full GLM-5.3 has no KDA states, so a
+    stream slot (``forward.Slots``) adds only its device positions."""
+
+    from tensorfold.cuda.geometry import full_buffer_bytes, full_token_bytes
+
+    from .verify import FULL_MAX_ROWS
+
+    if parallel <= 1:
+        return 0
+    return ((parallel - 1) * slots * full_token_bytes(t, kv, mtp)
+            + full_buffer_bytes(t, FULL_MAX_ROWS, world=world, share=share, capacity=parallel * slots,
+                                prefill=False, prompt_split_k=prompt_split_k)
+            + parallel * 16)
+
+
+def dspark_multi_bytes(draft_dir, parallel: int, rank: int, world: int, *, capacity: int, ring: bool) -> int:
+    """--parallel N with a DSpark speculator: its N stream contexts (``dspark_multi.DSparkMulti``) beside the solo
+    drafter's, each a context ring (~35 MiB a stream at three ranks) and its tap and candidate buffers, all sharing
+    the weights. ``capacity``: a flat context's tokens (no ring, TF_GLM_DRAFT_RING=0: the pool)."""
+
+    from .dspark import DSparkConfig, memory
+
+    if parallel <= 1:
+        return 0
+    m = memory(DSparkConfig.read(Path(draft_dir)), rank, world, capacity=capacity, ring=ring)
+    return parallel * (m["kv"] + m["fixed"])
+
+
+def full_pool_rows(slots: int, parallel: int, spare: int, token_bytes: int, align: int) -> tuple[int, int]:
+    """--parallel N on full GLM-5.3: (the pool's tokens, the most one stream holds). The admitted window is each
+    stream's: the pool is N windows (``slots`` cache slots each) plus what ``spare`` bytes (TF_GLM_CACHE_GIB beyond
+    the kept prompts' drafter windows) hold of other conversations' kept prompts, in whole ``align``-token extents;
+    a stream holds at most an even split of it, so N streams at their longest always fit together."""
+
+    pool = (parallel * slots + max(0, spare) // max(1, token_bytes)) // align * align
+    return pool, pool // parallel // align * align
+
+
 def is_dspark(draft_dir) -> bool:
     """Whether ``draft_dir`` holds a DSpark speculator (``dspark``: speculators_model_type "dspark", full GLM-5.3's)
     rather than a DFlash2 drafter."""
