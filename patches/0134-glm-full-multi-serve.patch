new file mode 100644
index 0000000..269a653
--- /dev/null
+++ tensorfold/families/glm5_next/cuda/dspark_multi.py
@@ -0,0 +1,135 @@
+"""DSpark for several streams at once (full GLM-5.3 under --parallel): one speculator's weights, a context per stream.
+
+Each stream's context is a ``dspark.Drafter`` of its own that shares every weight of the engine's drafter (a shallow
+copy: the layers, fc, norms, Markov tables, confidence head and the verifier's embedding / head are the same tensors)
+and owns what a sequence changes: its K/V context ring (``kc`` / ``vc``, ~35 MiB a stream at three ranks with the
+real checkpoint's 2,176-row ring), ``context_end`` and its device mirror ``pos_dev``, the block's ids and the
+candidate buffers. So a stream's drafts are exactly those its own solo drafter would make (the same calls on the
+same weights and the same context rows), and a context duck-types the solo drafter wherever one stream's context is
+handled on its own (``decode.prefill_chunk``'s taps, ``multi``'s kept prompts: ``ring``, ``window``, ``kc``, ``vc``).
+
+Milestone 2 (eager): proposals run one stream after another (a block pass each, its candidates gathered over the
+ranks as alone), context updates one stream after another; no CUDA graphs for the contexts yet (the solo drafter's
+graphs bind its own buffers, so a context starts without them). Unlike ``dflash2_multi.MultiDrafter`` (DFlash2's
+block is the anchor plus block - 1 drafts), a DSpark pass gives ``block`` drafts (8): a stream may draft up to 8.
+
+API (the ``dflash2_multi.MultiDrafter`` calls ``multi.MultiDecoder`` makes; both ranks call it identically):
+
+    md = DSparkMulti(drafter, streams=4)
+    ctx = md.contexts[i]
+    chains = md.propose([DraftRequest(ctx, pending, depth, sampling, confidence, beta, round_ms), ...])
+    md.commit([(ctx, taps), ...])                   # each stream's kept rows' taps [n, taps * D]
+"""
+
+from __future__ import annotations
+
+import copy
+from typing import Sequence
+
+import torch
+
+
+def context(drafter):
+    """A DSpark context sharing ``drafter``'s weights, with fresh sequence buffers (empty: context_end 0)."""
+
+    c = copy.copy(drafter)
+    pinned = torch.cuda.is_available()
+    c.kc = [torch.zeros_like(t) for t in drafter.kc]
+    c.vc = [torch.zeros_like(t) for t in drafter.vc]
+    c.pos_dev = torch.zeros_like(drafter.pos_dev)
+    c.context_end = 0
+    c.ids = drafter.ids.clone()
+    c.ids_host = torch.zeros(drafter.ids_host.shape, dtype=drafter.ids_host.dtype, pin_memory=pinned)
+    c.tap_in = torch.zeros_like(drafter.tap_in)
+    c.cand = torch.zeros_like(drafter.cand)
+    c.cand_host = torch.zeros(drafter.cand_host.shape, dtype=drafter.cand_host.dtype, pin_memory=pinned)
+    c.cand_ready = torch.cuda.Event() if pinned else None
+    c.packed = c.cand[:c.cand_n].view(c.gathered, c.block, 2 * c.top_k)
+    c.hconf = c.cand[c.cand_n:]
+    c.pool = None                         # the solo drafter's graphs replay ITS buffers: none here (eager)
+    c.block_graph = None
+    c.tap_graphs = {}
+    c.last_confidence = []
+    c.last_h = c.last_logits = None
+    return c
+
+
+def context_bytes(drafter) -> int:
+    """Device bytes one stream's context holds beyond the shared weights (``context``)."""
+
+    held = list(drafter.kc) + list(drafter.vc) + [drafter.pos_dev, drafter.ids, drafter.tap_in, drafter.cand]
+    return sum(t.numel() * t.element_size() for t in held)
+
+
+class DSparkMulti:
+    """Up to ``streams`` DSpark streams over one ``dspark.Drafter``'s weights (its own context stays the solo one)."""
+
+    def __init__(self, drafter, streams: int = 4) -> None:
+        if not type(drafter).__module__.endswith(".dspark"):
+            raise ValueError("DSparkMulti takes a DSpark drafter (dspark.Drafter); DFlash2: dflash2_multi.MultiDrafter")
+        if streams < 1:
+            raise ValueError("a multi-stream drafter needs at least one stream")
+        self.d = drafter
+        self.streams = streams
+        self.block = drafter.block              # drafts a pass gives (not block - 1: the anchor predicts the first)
+        self.contexts = [context(drafter) for _ in range(streams)]
+        for i, c in enumerate(self.contexts):
+            c.owner, c.slot = self, i
+
+    def nbytes(self) -> int:
+        """The contexts' buffers (the weights are the drafter's)."""
+        return sum(context_bytes(c) for c in self.contexts)
+
+    def reset(self) -> None:
+        for c in self.contexts:
+            c.reset()
+
+    def capture(self) -> None:
+        """No CUDA graphs for the stream contexts yet (milestone 2 runs them eagerly)."""
+
+    def drop_graphs(self) -> None:
+        pass
+
+    def _own(self, ctx) -> None:
+        if getattr(ctx, "owner", None) is not self:
+            raise ValueError("not one of this drafter's stream contexts")
+
+    @torch.no_grad()
+    def propose(self, reqs: Sequence) -> list[list[int]]:
+        """Each stream's ``Drafter.propose`` (up to ``block`` drafts), one stream after another; streams without a
+        depth or a context get [] (as a solo drafter runs none for them)."""
+
+        seen: set[int] = set()
+        out: list[list[int]] = []
+        for r in reqs:
+            self._own(r.ctx)
+            if r.ctx.slot in seen:
+                raise ValueError("a round proposes for each stream at most once")
+            seen.add(r.ctx.slot)
+            depth = min(int(r.depth), self.block)
+            if depth < 1 or r.ctx.context_end == 0:
+                out.append([])
+                continue
+            out.append(list(r.ctx.propose(r.pending, depth, r.sampling, r.confidence, beta=r.beta,
+                                          round_ms=r.round_ms)))
+        return out
+
+    @torch.no_grad()
+    def commit(self, items: Sequence[tuple]) -> None:
+        """Each stream's committed rows' taps at its positions context_end, context_end + 1, ... (its own context)."""
+
+        seen: set[int] = set()
+        for c, taps in items:
+            self._own(c)
+            if c.slot in seen:
+                raise ValueError("commit takes each of this drafter's streams at most once")
+            seen.add(c.slot)
+            if c.context_end + taps.shape[0] > c.capacity:
+                raise ValueError("drafter context past its capacity")
+        for c, taps in items:
+            if taps.shape[0]:
+                c.add_taps(taps)
+
+    def candidates(self, reqs):
+        raise ValueError("TF_GLM_MULTI_DEPTH=joint is GLM-5.3-Flash's (DFlash2's batched block pass): full GLM-5.3 "
+                         "takes policy or scale:A")
