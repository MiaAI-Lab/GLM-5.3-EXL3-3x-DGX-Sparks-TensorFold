@@ -62,6 +62,21 @@ class StopVote:
         return self.agreed
 
 
+# TF_GLM_MEM_TRACE=1: every rank logs PyTorch's allocated / reserved memory and the peak since the last line after each
+# prompt chunk (the prompt path's peak against the guard's floor); off by default
+MEM_TRACE = __import__("os").environ.get("TF_GLM_MEM_TRACE", "0") == "1"
+
+
+def mem_trace(e, what: str) -> None:
+    torch.cuda.synchronize()
+    gib = 1 << 30
+    free, _ = torch.cuda.mem_get_info()
+    print(f"[tensorfold] mem rank {e.w.rank}: {what}: allocated {torch.cuda.memory_allocated() / gib:.2f} GiB, "
+          f"reserved {torch.cuda.memory_reserved() / gib:.2f}, peak allocated {torch.cuda.max_memory_allocated() / gib:.2f}"
+          f", peak reserved {torch.cuda.max_memory_reserved() / gib:.2f}, device free {free / gib:.2f}", flush=True)
+    torch.cuda.reset_peak_memory_stats()
+
+
 def stopped(e) -> bool:
     """Whether every rank agreed to end this run (``StopVote``); False outside a voting run."""
 
@@ -646,6 +661,8 @@ def prefill(e: Engine, prompt: Sequence[int], sampling: Sampling | None, *, mtp:
         for start in range(begin, len(prompt), e.prefill_rows):
             last = prefill_chunk(e, prompt, start, min(e.prefill_rows, len(prompt) - start), drafter=drafter,
                                  feed=feed, mtp=use_mtp, head=sample)
+            if MEM_TRACE:
+                mem_trace(e, f"prefill chunk at {start}")
         prof.active = False
         prof.report(len(prompt) - begin)
     if not sample:
