+def index_kinds(t: dict, layers: int) -> list[str]:
+    """Each layer's indexer type ("full" or "shared") as transformers' GlmMoeDsaConfig derives it."""
+
+    kinds = t.get("indexer_types")
+    if kinds is None:
+        pattern = t.get("index_topk_pattern")
+        if pattern is not None:
+            kinds = [{"F": "full", "S": "shared"}[c] for c in pattern] if isinstance(pattern, str) else list(pattern)
+        else:
+            freq = max(int(t.get("index_topk_freq", 1) or 1), 1)
+            offset = int(t.get("index_skip_topk_offset", 2))
+            kinds = ["full" if max(i - offset + 1, 0) % freq == 0 else "shared" for i in range(layers)]
+    kinds = [str(k) for k in kinds]
+    if len(kinds) != layers or any(k not in ("full", "shared") for k in kinds) or (kinds and kinds[0] != "full"):
+        raise ValueError(f"indexer types: {layers} of full / shared starting with full, not {kinds}")
+    return kinds
