+def expert_tensor_names(prefix: str, layer: int, experts: int) -> list[str]:
+    """A full GLM-5.3 layer's routed expert tensors in the order ``load_full`` reads them."""
+
+    p = prefix + f"layers.{layer}.mlp."
+    return [p + f"experts.{e}.{proj}.{x}" for proj in ("gate_proj", "up_proj", "down_proj") for e in range(experts)
+            for x in ("trellis", "suh", "svh")]
+
+
+def pack_experts(parts: dict, experts: int, dev, codebook: str = "mcg"):
+    """A layer's routed experts from {(proj, e): (trellis, suh, svh)} CPU tensors (this rank's slices, each at its own
+    width): every trellis copied into one int16 buffer on the device (one allocation a layer instead of 768), the
+    universal kernels' pointer tables over its slices (``tensorfold.cuda.exl3.experts.prepare``)."""
+
+    from tensorfold.cuda.exl3 import experts as generic
+
+    order = [(proj, e) for proj in ("gate_proj", "up_proj", "down_proj") for e in range(experts)]
+    sizes = [parts[k][0].numel() for k in order]
+    buf = torch.empty((sum(sizes),), dtype=torch.int16, device=dev)
+    views, at = {}, 0
+    for k, n in zip(order, sizes):
+        t = parts[k][0]
+        if t.dtype != torch.int16:
+            t = t.view(torch.int16)
+        v = buf[at:at + n].view(t.shape)
+        v.copy_(t, non_blocking=False)
+        views[k] = v
+        at += n
+
+    def triples(proj):
+        return [(views[(proj, e)], parts[(proj, e)][1].to(dev), parts[(proj, e)][2].to(dev)) for e in range(experts)]
+
+    ex = generic.prepare(triples("gate_proj"), triples("up_proj"), triples("down_proj"), codebook, device=dev)
+    ex.keep[:] = [buf]                    # the views' storage (the pointer tables point into it)
+    if ex.suh_g.shape == ex.suh_u.shape and torch.equal(ex.suh_g, ex.suh_u):
+        ex.suh_u = ex.suh_g               # gate and up share their input rotation (the checkpoint's are identical)
+    return ex
+
+
+def load_full(model_dir: str | Path, cfg: Config, *, rank: int, world: int, device: str = "cuda",
+              mtp: bool = True) -> Weights:
+    """Rank ``rank`` of ``world`` of full GLM-5.3 (``glm_moe_dsa``): EXL3 routed experts of mixed widths (the universal
+    grouped kernels), BF16 elsewhere as TF_GLM_DENSE holds it; heads, expert blocks (rotated by layer), the dense
+    MLP's and shared expert's widths and the head's rows split by ``tp.Layout``; the indexer on full layers only."""
+
+    from .split import RankReader
+    from .tp import Layout
+
+    lay = Layout.from_config(cfg, rank, world)
+    if cfg.quant != "exl3":
+        raise ValueError(f"full GLM-5.3's CUDA engine reads EXL3 checkpoints (routed experts), not {cfg.quant}")
+    if not latent.ENABLED:
+        raise ValueError("full GLM-5.3 needs the latent cache (TF_GLM_LATENT=1)")
+    dev = torch.device(device)
+    rd = RankReader(model_dir, rank, world)
+    P = cfg.prefix
+    HL = lay.heads
+    fp8 = dense_kind() in ("fp8", "q4")
+    dense, dense_stack = (make_f8, stack_f8) if fp8 else (make_b16, stack_b16)
+    if dense_kind() == "q4":
+        from .qmm import make_dense_q4, stack_dense_q4
+
+        big, big_stack = make_dense_q4, stack_dense_q4
+    else:
+        big, big_stack = dense, dense_stack
+    if kvb_kind() != "bf16":
+        raise ValueError("full GLM-5.3 holds kv_b in bf16 (TF_GLM_KVB=bf16): its key rows are padded for the "
+                         "absorb kernels")
+
+    def t(name: str, dtype: torch.dtype | None = None) -> torch.Tensor:
+        x = rd.get(P + name)
+        if dtype is not None:
+            x = x.to(dtype)
+        return x.to(dev)
+
+    def q4(name: str):
+        return big(t(name + ".weight"))
+
+    def stack(names: list[str]):
+        return big_stack([t(n + ".weight") for n in names])
+
+    nope, rope, vd = cfg.nope, cfg.rope, cfg.v_dim
+
+    def dsa(i: int, indexed: bool) -> DSAW:
+        """Layer i's attention; ``indexed``: it runs the indexer (a full layer, and the MTP layer, whose
+        index_share_for_mtp_iteration shares its top-k between the MTP head's chained steps, not with the trunk)."""
+        p = f"layers.{i}.self_attn."
+        proj = stack([p + "q_a_proj", p + "kv_a_proj_with_mqa"])
+        w = t(p + "kv_b_proj.weight").view(HL, nope + vd, cfg.kv_lora)
+        # the key rows padded to the query head's width with zero rows (the rotary dims'), so absorb_q reads the whole
+        # query head and the rotary part multiplies zeros: the same sums, exactly
+        wk = torch.zeros((HL, cfg.qk_dim, cfg.kv_lora), dtype=torch.bfloat16, device=dev)
+        wk[:, :nope].copy_(w[:, :nope])
+        absorb = latent.AbsorbW(wk, w[:, nope:].contiguous())
+        del w
+        ix = None
+        if indexed:
+            ix = IndexW(stack([p + "indexer.wk", p + "indexer.weights_proj"]), q4(p + "indexer.wq_b"),
+                        t(p + "indexer.k_norm.weight"), t(p + "indexer.k_norm.bias"))
+        return DSAW(proj, t(p + "q_a_layernorm.weight"), t(p + "kv_a_layernorm.weight"), q4(p + "q_b_proj"), None,
+                    None, q4(p + "o_proj"), HL, ix, absorb)
+
+    def mlp(p: str) -> MLPW:
+        gu = stack([p + "gate_proj", p + "up_proj"])
+        return MLPW(gu, q4(p + "down_proj"), gu.n // 2)
+
+    def names(i: int) -> list[str]:
+        if i > cfg.layers or (i == cfg.layers and not (mtp and cfg.mtp_layers)):
+            return []
+        if i < cfg.layers and cfg.mlp_kinds[i] != "moe":
+            return []
+        return expert_tensor_names(P, i, cfg.experts)
+
+    def moe(i: int) -> MoEW:
+        p = f"layers.{i}.mlp."
+        router = t(p + "gate.weight", torch.bfloat16).contiguous()
+        bias = t(p + "gate.e_score_correction_bias", torch.float32).contiguous()
+        parts = {}
+        for proj in ("gate_proj", "up_proj", "down_proj"):
+            for e in range(cfg.experts):
+                n = P + p + f"experts.{e}.{proj}."
+                parts[(proj, e)] = (rd.get(n + "trellis"), rd.get(n + "suh"), rd.get(n + "svh"))
+        ex = pack_experts(parts, cfg.experts, dev)
+        del parts
+        return MoEW(router, bias, ex, mlp(p + "shared_experts."))
+
+    events: list = []
+    gpu = dev.type == "cuda"             # CPU: the tests' tiny checkpoints
+
+    def layer(i: int, mtp_layer: bool = False) -> LayerW:
+        if gpu and len(events) >= 2:
+            events.pop(0).synchronize()
+        rd.prefetch(names(i), None)
+        rd.prefetch(names(i + 1), None)
+        lw = LayerW(i, "dsa", None, None, t(f"layers.{i}.input_layernorm.weight"),
+                    t(f"layers.{i}.post_attention_layernorm.weight"))
+        lw.dsa = dsa(i, mtp_layer or cfg.index_kinds[i] == "full")
+        if not mtp_layer and cfg.mlp_kinds[i] == "dense":
+            lw.mlp = mlp(f"layers.{i}.mlp.")
+        else:
+            lw.moe = moe(i)
+        if gpu and i % 8 == 7:
+            torch.cuda.empty_cache()
+        if gpu:
+            events.append(torch.cuda.current_stream().record_event())
+        return lw
+
+    v0, v1 = lay.vocab_offset, lay.vocab_offset + lay.vocab
+    # the embedding split by vocabulary rows as lm_head is (``forward.embed_rows``): a third of 1.77 GiB a rank
+    embed = rd.get(P + "embed_tokens.weight")[v0:v1].to(torch.bfloat16).contiguous().to(dev)
+    try:
+        built = [layer(i) for i in range(cfg.layers)]
+        raw = rd.get("lm_head.weight")[v0:v1].to(dev)
+        head = dense(raw)
+        draft_head = draft_quantize4(raw) if mtp and cfg.mtp_layers else None
+        del raw
+        mtpw = None
+        if cfg.mtp_layers and mtp:
+            i = cfg.layers
+            mtpw = MTPW(t(f"layers.{i}.enorm.weight"), t(f"layers.{i}.hnorm.weight"), q4(f"layers.{i}.eh_proj"),
+                        t(f"layers.{i}.shared_head.norm.weight"), layer(i, mtp_layer=True))
+        w = Weights(cfg, embed, built, t("norm.weight"), head, mtpw, rank, world, dev, draft_head=draft_head, tp=lay)
+        w.meta.update(layers=list(range(cfg.layers)), embed_offset=v0)
+        from .dsa_full import inv_freq
+
+        w.meta["rope_freq"] = inv_freq(cfg.rope, cfg.rope_theta, dev)
+    finally:
+        rd.close()
+    if gpu:
+        torch.cuda.empty_cache()
+    return w
