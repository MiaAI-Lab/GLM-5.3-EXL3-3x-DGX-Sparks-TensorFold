+def local_rows(n: int, rank: int, cp: int) -> int:
+    """Context parallelism (TF_GLM_CP): the rows a rank holds of a cache plane's first n positions, the positions p < n
+    with p % cp == rank (at local rows p // cp); n without it."""
+
+    if cp <= 1:
+        return int(n)
+    return max(0, (int(n) - int(rank) + cp - 1) // cp)
