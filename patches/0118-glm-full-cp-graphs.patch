 CP_PROMPT_ROWS = 512       # context parallelism: a prompt chunk's rows a query gather / partials exchange takes
+
+
+class CpScratch:
+    """Context parallelism's per-window buffers for a decode buffer's rows (allocated once, before any capture, so
+    captured windows reuse them instead of each graph keeping its own): candidates, the gathered candidates, local
+    lists, selection scores, gathered queries, partials and their exchange."""
+
+    def __init__(self, w: Weights, rows: int, cols: int, dev) -> None:
+        from . import latent
+
+        c = w.cfg
+        G, HP, k = int(w.meta["cp"]), int(w.meta["cp_heads"]), c.index_topk
+        LW, RD, H = c.kv_lora, c.rope, int(w.meta["cp"]) * int(w.meta["cp_heads"])
+        f32, bf = torch.float32, torch.bfloat16
+        self.cand = torch.empty((rows, k), dtype=torch.int64, device=dev)
+        self.every = torch.empty((G * rows * k,), dtype=torch.int64, device=dev)
+        self.slots = torch.empty((rows, k), dtype=torch.int32, device=dev)
+        self.counts = torch.empty((rows,), dtype=torch.int32, device=dev)
+        self.sel = torch.empty((min(rows, 128) * cols,), dtype=f32, device=dev)
+        self.mine = torch.empty((rows, HP, LW + RD), dtype=bf, device=dev)
+        self.allq = torch.empty((G * rows * HP * (LW + RD),), dtype=bf, device=dev)
+        self.qa_all = torch.empty((rows, H, LW), dtype=bf, device=dev)
+        self.qp_all = torch.empty((rows, H, RD), dtype=bf, device=dev)
+        self.o = torch.empty((rows, H, LW), dtype=f32, device=dev)
+        self.lse = torch.empty((rows, H), dtype=f32, device=dev)
+        n = -(-k // latent.CHUNK) * rows * H
+        self.parts = (torch.empty((n * LW,), dtype=f32, device=dev), torch.empty((n,), dtype=f32, device=dev),
+                      torch.empty((n,), dtype=f32, device=dev))
+        self.ob = torch.empty((rows, H, LW), dtype=bf, device=dev)
+        self.send_o = torch.empty((G * rows * HP * LW,), dtype=bf, device=dev)
+        self.send_l = torch.empty((G * rows * HP,), dtype=f32, device=dev)
+        self.got_o = torch.empty((G * rows * HP * LW,), dtype=bf, device=dev)
+        self.got_l = torch.empty((G * rows * HP,), dtype=f32, device=dev)
+        self.got_f = torch.empty((G * rows * HP * LW,), dtype=f32, device=dev)
+        self.merged = torch.empty((rows, HP, LW), dtype=bf, device=dev)
+
+
+def cp_scratch(w: Weights, b: Buffers, keys: torch.Tensor) -> CpScratch:
+    """``b``'s CpScratch, made at its first window (an eager warm-up, never inside a capture)."""
+
+    sc = getattr(b, "cp_scratch", None)
+    if sc is None:
+        sc = b.cp_scratch = CpScratch(w, b.rows, keys.shape[0], b.x.device)
+    return sc
 # TF_GLM_MSA (default 1): prompt chunks' sparse attention through Mia's sparse attention kernel (FP8 caches, <= 24
 # heads a rank); 0: the chunk programs and their merge
 PROMPT_MSA = os.environ.get("TF_GLM_MSA", "1") != "0"
