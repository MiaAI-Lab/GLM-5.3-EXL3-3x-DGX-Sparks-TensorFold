index 0000000..2d8cd53
--- /dev/null
+++ tensorfold/cuda/exl3/mpe.py
@@ -0,0 +1,85 @@
+"""Mia's prompt experts (MPE, mpe.cu): the routed EXL3 experts of a prompt chunk, a width per expert (2, 3 or 4 bits),
+on tensor cores with the trellis decoded on the fly; every pair's output row stored unweighted ([pairs, D] fp32, no
+atomics), so a row's bits do not depend on the other rows, the chunking or the run. The caller adds the slots in slot
+order (glue.combine_shared). By Mia's AI Lab (Apache-2.0)."""
+
+from __future__ import annotations
+
+import math
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from .experts import ACT_F32, Exl3RoutedExperts
+
+K2S = (4, 6, 8)               # 2, 3 and 4 bits a value
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    import os
+
+    defs = [f for f in os.environ.get("TF_MPE_DEFINES", "").split(",") if f]          # lab ablations only
+    flags = [f"-D{f}" for f in defs]
+    return load(name="tensorfold_exl3_mpe_v5" + "".join("_" + f.lower() for f in defs),
+                sources=[str(here / "mpe.cpp"), str(here / "mpe.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo"] + flags, extra_include_paths=[str(here)], verbose=False)
+
+
+def supported(ex: Exl3RoutedExperts) -> bool:
+    """Gate and up of each expert at one width, every width 2/3/4 bits, widths in whole 128 blocks."""
+
+    gk, uk, dk = ex.gate_k2.tolist(), ex.up_k2.tolist(), ex.down_k2.tolist()
+    if not (gk == uk and all(k in K2S for k in gk + dk) and ex.width % 128 == 0 and ex.dims % 256 == 0):
+        return False
+    # one input rotation for the layer: every expert's gate and up take the same suh
+    return bool(torch.equal(ex.suh_g, ex.suh_u) and (ex.suh_g == ex.suh_g[:1]).all())
+
+
+class Scratch:
+    """Buffers for up to ``rows`` rows of ``slots`` slots (``xd``: a contiguous fp16 buffer of >= pairs x width, and
+    ``xr``: one of >= rows x dims, may be lent)."""
+
+    def __init__(self, ex, rows: int, slots: int, device="cuda", xd: torch.Tensor | None = None,
+                 xr: torch.Tensor | None = None) -> None:
+        n = rows * slots
+        bm = _ext().item_rows()
+        self.rows, self.slots = rows, slots
+        self.max_items = -(-n // bm) + min(n, ex.count)
+        self.sorted = torch.empty((n,), dtype=torch.int32, device=device)
+        self.items = torch.empty((3 * self.max_items,), dtype=torch.int32, device=device)
+        self.count = torch.zeros((1,), dtype=torch.int32, device=device)
+        if xd is not None and (xd.dtype != torch.float16 or not xd.is_contiguous() or xd.numel() < n * ex.width):
+            raise ValueError("mpe.Scratch: the lent xd is too small")
+        self.xd = xd.view(-1)[:n * ex.width].view(n, ex.width) if xd is not None else \
+            torch.empty((n, ex.width), dtype=torch.float16, device=device)
+        if xr is not None and (xr.dtype != torch.float16 or not xr.is_contiguous() or xr.numel() < rows * ex.dims):
+            raise ValueError("mpe.Scratch: the lent xr is too small")
+        self.xr = xr.view(-1)[:rows * ex.dims].view(rows, ex.dims) if xr is not None else \
+            torch.empty((rows, ex.dims), dtype=torch.float16, device=device)
+
+
+def pairs(x: torch.Tensor, pick: torch.Tensor, ex: Exl3RoutedExperts, scratch: Scratch, y: torch.Tensor,
+          limit: float = math.inf, act_mode: int = ACT_F32) -> torch.Tensor:
+    """y [R * S, D] fp32: row r * S + s = expert pick[r, s](x[r]), unweighted (picks outside [0, E): not written).
+    R <= scratch.rows; no host sync."""
+
+    ext = _ext()
+    R, S = pick.shape
+    if R > scratch.rows or S != scratch.slots:
+        raise ValueError(f"{R} rows x {S} slots but the scratch holds {scratch.rows} x {scratch.slots}")
+    P = R * S
+    if y.dtype != torch.float32 or not y.is_contiguous() or y.shape[0] < P or y.shape[1] != ex.dims:
+        raise ValueError("mpe.pairs: y contiguous fp32 [>= R * S, D]")
+    pick = pick.contiguous()
+    items = min(scratch.max_items, -(-P // ext.item_rows()) + min(P, ex.count))
+    ext.route(pick, ex.count, scratch.sorted, scratch.items, scratch.count, items)
+    xd = scratch.xd.view(-1)[:P * ex.width].view(P, ex.width)
+    ext.experts(x, scratch.sorted[:P], scratch.items, scratch.count, ex.gate_ptr, ex.up_ptr, ex.down_ptr,
+                ex.gate_k2, ex.down_k2, ex.suh_g, ex.suh_u, ex.svh_g, ex.svh_u, ex.suh_d, ex.svh_d, scratch.xr, xd, y,
+                ex.dims, ex.width, S, items, float(limit), act_mode, ex.cb)
+    return y[:P]
