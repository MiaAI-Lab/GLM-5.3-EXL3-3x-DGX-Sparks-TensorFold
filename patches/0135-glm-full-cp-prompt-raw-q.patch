+def cp_replicate_absorb(w: Weights) -> int:
+    """Every DSA layer's (the MTP head's too) other ranks' absorb key rows (their nope rows of kv_b, padded to HP
+    heads and DQ rows with zeros), gathered once from the ranks (their bits as loaded) into ``DSAW.cp_absorb``: a
+    latent.AbsorbW a peer, rank order without this rank. A collective: every rank calls it alike. Returns the bytes
+    kept."""
+
+    c = w.cfg
+    G, rank, HP = int(w.meta["cp"]), int(w.rank), int(w.meta["cp_heads"])
+    nope, LW = c.nope, c.kv_lora
+    DQ = cp_raw_dims(nope)
+    gather_all = getattr(w.comm, "nccl", w.comm).all_gather
+    layers = [layer for layer in w.layers if getattr(layer, "dsa", None) is not None]
+    if w.mtp is not None and getattr(w.mtp.layer, "dsa", None) is not None:
+        layers.append(w.mtp.layer)
+    kept = 0
+    mine = every = None
+    for layer in layers:
+        a = layer.dsa
+        if not isinstance(a.absorb, latent.AbsorbW):
+            raise ValueError("TF_GLM_CP_RAW_Q: bf16 absorb weights (latent.AbsorbW) expected")
+        if mine is None:
+            mine = torch.zeros((HP, DQ, LW), dtype=torch.bfloat16, device=a.absorb.wk.device)
+            every = torch.empty((G, HP, DQ, LW), dtype=torch.bfloat16, device=mine.device)
+        mine.zero_()
