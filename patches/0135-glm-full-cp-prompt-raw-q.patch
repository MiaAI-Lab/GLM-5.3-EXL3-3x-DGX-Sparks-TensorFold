+def cp_raw_dims(nope: int) -> int:
+    """DQ: the raw query dims a head sends and absorbs over, the nope dims rounded up to the MMA's k step."""
+    bk = latent.MMA_TILE[2]
+    return -(-int(nope) // bk) * bk
+
