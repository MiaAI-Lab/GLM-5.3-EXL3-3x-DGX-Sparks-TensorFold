+        peers = torch.stack([every[p] for p in range(G) if p != rank]).contiguous()
+        none = torch.empty((HP, 0, LW), dtype=torch.bfloat16, device=mine.device)
+        a.cp_absorb = [latent.AbsorbW(peers[s], none) for s in range(G - 1)]
+        kept += peers.numel() * 2
+    return kept
+
