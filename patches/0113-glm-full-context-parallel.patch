+
+
+def dsa_full_cp(layer: LayerW, w: Weights, lc: torch.Tensor, kr: torch.Tensor, pos_dev: torch.Tensor, b: Buffers,
+                R: int, keys: torch.Tensor | None, host_pos: int | None, sparse_np: int | None) -> torch.Tensor:
+    """dsa_full_block under context parallelism (TF_GLM_CP; ``dcp``, work/DCP-DESIGN.md): the rank's caches hold the
+    positions p with p % cp == rank (rows p // cp); every row takes the selection path (a row that sees k tokens or
+    fewer keeps them all): on a full layer each rank scores its own tokens, the ranks' candidates are gathered and
+    merged into the exact replicated top-k, split by owner; the absorbed queries of every head are gathered, each rank
+    attends all heads over its own tokens (fp32 output and log-sum-exp), the partials go to the heads' owners and
+    are merged in rank order. The same arithmetic for every row of any window: drafted replies equal serial ones."""
+
+    from . import dcp, dsa_full
+
+    c = w.cfg
+    a = layer.dsa
+    HL = a.heads
+    G, rank = int(w.meta["cp"]), int(w.rank)
+    q0, l0 = c.q_lora, c.q_lora + c.kv_lora
+    freq = w.meta["rope_freq"]
+    with prof.timed("dsa: projections"):
+        mm(b, b.normed[:R], a.proj, b.xs[:R], b.dp[:R])
+        glue.rmsnorm(b.dp[:R, :q0], a.q_norm, c.eps, b.qr[:R], b.xs_qr[:R])
+        glue.rmsnorm(b.dp[:R, q0:l0], a.kv_norm, c.eps, b.lat[:R], b.xs_lat[:R])
+        mm(b, b.qr[:R], a.q_b, b.xs_qr[:R], b.q[:R].view(R, HL * c.qk_dim))
+    with prof.timed("dsa: latent write"):
+        latent.latent_write(b.lat[:R], lc, pos_dev, cp=G, rank=rank)
+        dsa_full.k_rope_write(b.dp[:R, l0:], kr, pos_dev, freq, cp=G, rank=rank)
+    qp = dsa_full.q_rope(b.q[:R], b.qp[:R], pos_dev, freq, c.nope)
