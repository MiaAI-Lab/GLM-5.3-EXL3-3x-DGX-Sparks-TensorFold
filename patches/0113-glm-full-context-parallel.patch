+            w.comm.all_gather(mine.reshape(-1), allq)
+            allq = allq.view(G, n, HP, LW + RD).permute(1, 0, 2, 3).reshape(n, G * HP, LW + RD)
+            qa_all = allq[:, :, :LW].contiguous()
+            qp_all = allq[:, :, LW:].contiguous()
+            o, lse = dcp.attention_partial(qa_all, qp_all, lc, kr, tokens[r0:r1], counts[r0:r1], scale)
+            # each head owner's partials of every rank, rank order (own slot copied)
+            got_o = torch.empty((G, n, HP, LW), dtype=torch.float32, device=qa.device)
+            got_l = torch.empty((G, n, HP), dtype=torch.float32, device=qa.device)
+            sends = {p: [o[:, p * HP:(p + 1) * HP].contiguous(), lse[:, p * HP:(p + 1) * HP].contiguous()]
+                     for p in range(G) if p != rank}
+            recvs = {p: [got_o[p], got_l[p]] for p in range(G) if p != rank}
+            got_o[rank].copy_(o[:, rank * HP:(rank + 1) * HP])
+            got_l[rank].copy_(lse[:, rank * HP:(rank + 1) * HP])
+            w.comm.exchange_all(sends, recvs)
+            merged = dcp.merge_ranks(got_o, got_l)
+            ol[r0:r1].copy_(merged[:, :HL])
+    with prof.timed("dsa: expand"):
+        o = latent.expand_v(ol, a.absorb, b.vn[:R], prompt=b.prefill and latent.PROMPT_MMA).view(R, HL * c.v_dim)
+    return out_proj(w, b, o, a.o, None if b.prefill else qmm.group_sums(o, b.xs_ao[:R]), R,
+                    site=(layer.index, "a"))
+
+
+CP_PROMPT_ROWS = 512       # context parallelism: a prompt chunk's rows a query gather / partials exchange takes
 # TF_GLM_MSA (default 1): prompt chunks' sparse attention through Mia's sparse attention kernel (FP8 caches, <= 24
 # heads a rank); 0: the chunk programs and their merge
 PROMPT_MSA = os.environ.get("TF_GLM_MSA", "1") != "0"
