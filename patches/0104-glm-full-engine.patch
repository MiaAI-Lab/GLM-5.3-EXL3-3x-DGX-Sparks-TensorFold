--- /dev/null
+++ tensorfold/families/glm_moe_dsa/__init__.py
@@ -0,0 +1,69 @@
+"""GLM-5.3 (model_type ``glm_moe_dsa``, zai-org's full model): a CUDA engine over three DGX Sparks, the GLM-5.3-Flash
+CUDA engine with full GLM-5.3's layers (``glm5_next/cuda``, ``weights.Config.full``): MLA with RoPE and DSA on all
+78 layers (the indexer on the "full" ones, its top-k reused on the "shared" ones), plain residuals, EXL3 routed
+experts of mixed widths (the universal grouped kernels), MTP drafts. No Mac engine."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+MODEL_TYPES = ("glm_moe_dsa",)
+TITLE = "GLM-5.3"
+LANES = False
+MODELS = ("Mia-AiLab/GLM-5.3-EXL3-2.75bpw-TensorFold",)
+QUANT_METHODS = {"cuda": ("exl3",)}
+CUDA_TP = (3, 4)                       # GPUs (one per machine): ~86 GiB of weights a rank at three
+SCOPE = "glm53_routed_experts_only"    # EXL3 routed experts (any width a tensor, mcg codebook), BF16 elsewhere
+
+
+def check(model_dir: str | Path) -> None:
+    """Refuse what the CUDA engine does not read: anything but EXL3 routed experts with the mcg codebook and BF16
+    elsewhere (each expert matrix's width comes from its own trellis)."""
+
+    from tensorfold.families import OWN_MODEL_HELP, describe_quantization, quant_method, read_config
+
+    config = read_config(model_dir)
+    if quant_method(config) != "exl3":
+        raise ValueError(f"GLM-5.3's CUDA engine reads EXL3 checkpoints ({MODELS[0]}); this one has "
+                         f"{describe_quantization(config)}. {OWN_MODEL_HELP}")
+    q = config.get("quantization_config") or config.get("quantization") or {}
+    if q.get("codebook", "mcg") != "mcg" or q.get("scope", SCOPE) != SCOPE:
+        raise ValueError(f"GLM-5.3's CUDA engine reads EXL3 routed experts with the mcg codebook and BF16 elsewhere "
+                         f"({MODELS[0]}); this one has codebook {q.get('codebook')!r}, scope {q.get('scope')!r}. "
+                         f"{OWN_MODEL_HELP}")
+    print("[tensorfold] GLM-5.3 runs on three NVIDIA GPUs with 128 GB each (three DGX Sparks): serve with --tp 3 on "
+          "each, the checkpoint readable on all three", flush=True)
+
+
+def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank: int = 0, master: str = "",
+                master_port: int = 29551, no_drafts: bool = False, mtp_drafts: int | None = None, **options: Any):
+    """The N-rank engine (N = 3 or 4) with MTP drafts (exact: drafted replies equal serial ones), or serial decoding
+    with --no-drafts."""
+
+    tp = int(tp)
+    if tp not in CUDA_TP:
+        raise ValueError(f"GLM-5.3 needs {' or '.join(map(str, CUDA_TP))} GPUs, one per machine: run the same "
+                         "`tensorfold serve` command with --tp N --rank R --master ADDRESS on each (rank 0 last)")
+    if not master:
+        raise ValueError(f"--tp {tp} needs --master: rank 0's address on the link between the machines")
+    if not 0 <= int(rank) < tp:
+        raise ValueError(f"--rank {rank}: 0 to {tp - 1} with --tp {tp}")
+    if drafter and not no_drafts:
+        raise ValueError("GLM-5.3 drafts with its MTP head: pass no --drafter")
+    if options.get("vision"):
+        raise ValueError("GLM-5.3 is a text model: no --vision")
+    from tensorfold.families.glm5_next.cuda.engine import DEFAULT_POLICY, GlmEngine
+
+    policy = DEFAULT_POLICY if mtp_drafts is None else str(int(mtp_drafts))
+    return GlmEngine(Path(model_dir), rank=int(rank), world=tp, master=master, port=int(master_port), policy=policy,
+                     drafter=None, context=options.get("context"), context_explicit=options.get("context_explicit"),
+                     serial_only=bool(no_drafts), parallel=int(options.get("parallel", 1)))
+
+
+def __getattr__(name: str) -> Any:
+    if name == "CUDA_APP":             # GLM-5.3-Flash's server side: the same tokenizer and chat format
+        from tensorfold.families.glm5_next.cuda.app import GlmApp
+
+        return GlmApp
+    raise AttributeError(name)
