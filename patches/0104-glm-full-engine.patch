+FULL_SELECT_ROWS = 128      # full GLM-5.3: a prompt chunk's rows whose fp32 token scores are held at once
+FULL_TOPK_MIN_BUCKET = 4096  # ... and the fewest token columns a decode window's selection scores (dsa_full)
+
+
+def full_counts(t: dict, mtp: bool) -> tuple[int, int]:
+    """Full GLM-5.3: (attention layers with caches, layers with an indexer) on a rank, the MTP layer's included."""
+    from tensorfold.families.glm5_next.cuda.weights import index_kinds
+
+    layers = int(t["num_hidden_layers"])
+    full = sum(1 for k in index_kinds(t, layers) if k == "full")
+    return layers + int(mtp), full + int(mtp)
+
+
+def full_token_bytes(t: dict, kv: str = "bf16", mtp: bool = True) -> int:
+    """Full GLM-5.3's cache bytes a token on every rank (MLA's cache is the same on all ranks): per attention layer
+    its latent row (bf16, or TF_GLM_KV=fp8's codes, scale and pad) and its rotary key (bf16), per indexer its
+    per-token index key (bf16)."""
+    layers, indexers = full_counts(t, mtp)
+    lw, rope, idx = int(t["kv_lora_rank"]), int(t["qk_rope_head_dim"]), int(t.get("index_head_dim", 128))
+    return layers * (mla_row_bytes(lw, kv) + 2 * rope) + indexers * 2 * idx
+
+
+def full_buffer_bytes(t: dict, rows: int, *, world: int, share, capacity: int, prefill: bool,
+                      prompt_split_k: bool) -> int:
+    """What ``forward.Buffers(w, rows, capacity, prefill=...)`` allocates on a rank of full GLM-5.3 (its tensors'
+    bytes, written out from the class; tests/cpu/test_full_memory.py checks the two agree)."""
+    D, V = int(t["hidden_size"]), share("vocab", int(t["vocab_size"]))
+    HL = share("heads", int(t["num_attention_heads"]))
+    ql, lw, rope = int(t["q_lora_rank"]), int(t["kv_lora_rank"]), int(t["qk_rope_head_dim"])
+    qk, vd = int(t["qk_nope_head_dim"]) + rope, int(t["v_head_dim"])
+    ih, idim = int(t.get("index_n_heads", 32)), int(t.get("index_head_dim", 128))
+    dl, ml = share("dense", int(t["intermediate_size"])), share("moe", int(t["moe_intermediate_size"]))
+    sl = share("shared", int(t["moe_intermediate_size"]) * int(t.get("n_shared_experts", 1)))
+    E, slots = int(t["n_routed_experts"]), int(t["num_experts_per_tok"]) + 1
+    R, P = rows, rows * slots
+    part_rows = min(rows, MLA_PROMPT_ATT_ROWS) if prefill else rows
+    chunks = -(-(min(capacity, 2560) + rows) // 512)
+    total = R * 8                                                         # ids (device and pinned host)
+    total += chunks * part_rows * HL * (lw + 2) * 4 + 2 * R * HL * lw * 2  # latent partials, absorbed q, attended
+    total += R * D * 2 * 4 + R * (D // 64) * 4 + R * 4 * (1 + 1 + 16 * 32)  # hin, x, normed, hidden (+ xs, hc)
+    total += R * (ql + lw + rope) * 2 + R * HL * rope * 2 + R * ql * 2 + R * (ql // 64) * 4 + R * lw * 2
+    total += R * (lw // 64) * 4 + 2 * R * HL * qk * 2 + R * HL * vd * 2 + R * (HL * vd // 64) * 4
+    total += R * (idim + ih) * 2 + R * idim * 4 + R * ih * idim * 2       # indexer rows
+    total += R * 3 * dl * 2 + R * (dl // 64) * 4                          # dense MLP
+    total += R * E * 4 + 2 * R * slots * 4 + P * ml * 2                    # routing, eact
+    cfg_gu, cfg_d = 4, 1                                                   # the universal kernels' K splits (GLM's)
+    total += 2 * P * D * 2 + P * ml * 2 + max(2 * cfg_gu * ml, cfg_d * D) * P * 4 + P * D * 4   # their scratch
+    total += min(P, E) * 4 * (1 + R) + 4
+    total += R * 3 * sl * 2 + R * (sl // 64) * 4 + R * D * 4               # shared expert
+    total += P * 4 + (P + 64) * 3 * 4 * 2 + P * 4 + (-(-P // 1024)) * (E + 1) * 4   # the (unused) grouping plan
+    total += R * D * 4 + world * R * D * 4                                  # partials and their gather
+    total += (4 if prefill and not prompt_split_k else 8 * R * 16384 * 4)  # split-K partials
+    total += 2 * R * D * 2 + R * (D // 64) * 4 + (1 if prefill else R) * V * 2   # final norm, logits
+    total += R * D * 2 * 4 + R * (2 * D // 64) * 4                         # MTP rows
+    return total
+
+
+def full_transient_bytes(t: dict, rows: int, capacity: int, *, prefill: bool, share) -> int:
+    """A window's selection and sparse attention scratch at the cache's capacity: fp32 token scores (a prompt chunk's
+    FULL_SELECT_ROWS rows at once; a decode window's rows over its bucket, at most the capacity), the token lists,
+    and a decode window's sparse attention partials (prompt chunks attend in one pass)."""
+    HL = share("heads", int(t["num_attention_heads"]))
+    lw, topk = int(t["kv_lora_rank"]), int(t.get("index_topk", 2048))
+    cols = max(capacity, FULL_TOPK_MIN_BUCKET)
+    scores = (min(rows, FULL_SELECT_ROWS) if prefill else rows) * cols * 4
+    lists = rows * (topk + 1) * 4
+    partials = 0 if prefill else -(-topk // 512) * rows * HL * (lw + 2) * 4
+    return scores + lists + partials
+
+
+def mla_full_geometry(t: dict, world: int, reserve: int, *, share, decode_rows: int, mtp_rows: int,
+                      prefill_rows: int, kv: str = "bf16", mtp: bool = True, prompt_split_k: bool = False,
+                      minimum_slots: int = 2560) -> Geometry:
+    """Full GLM-5.3's caches and buffers on a rank at a capacity of cache slots: the decode window's buffers (and the
+    MTP head's), the prompt chunk's, the per-token caches (``full_token_bytes``), and the largest transient
+    selection and attention scratch of either kind of window."""
+
+    def bytes_at(capacity: int) -> int:
+        b = full_buffer_bytes(t, decode_rows, world=world, share=share, capacity=capacity, prefill=False,
+                              prompt_split_k=prompt_split_k)
+        if mtp:
+            b += full_buffer_bytes(t, mtp_rows, world=world, share=share, capacity=capacity, prefill=False,
+                                   prompt_split_k=prompt_split_k)
+        b += full_buffer_bytes(t, prefill_rows, world=world, share=share, capacity=capacity, prefill=True,
+                               prompt_split_k=prompt_split_k)
+        b += max(full_transient_bytes(t, prefill_rows, capacity, prefill=True, share=share),
+                 full_transient_bytes(t, decode_rows, capacity, prefill=False, share=share))
+        return b + capacity * full_token_bytes(t, kv, mtp)
+    return Geometry(bytes_at, reserve, minimum_slots)
+
+
