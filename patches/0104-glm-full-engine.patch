     return lambda name, info: (0, 0) if name.startswith(prefix) else transform(name, info)
 
 
+def full_weights(transform, cfg, lay):
+    """Full GLM-5.3's startup weight transform on top of ``split_weights``' (and TF_GLM_DENSE's): a layer's kv_b key
+    rows are held padded with zero rows over the rotary dims (``weights.load_full``), rope x kv_lora bf16 values a
+    local head more; the embedding is split by vocabulary rows (``forward.embed_rows``)."""
+
+    pad = lay.heads * cfg.rope * cfg.kv_lora * 2
+
+    def out(name: str, info: dict) -> tuple[int, int]:
+        total, extra = transform(name, info)
+        if total and name.endswith("self_attn.kv_b_proj.weight"):
+            total += pad
+        if total and name == cfg.prefix + "embed_tokens.weight":   # split by vocabulary rows, as lm_head
+            total = lay.vocab * int(info["shape"][1]) * 2
+        return total, extra
+    return out
+
