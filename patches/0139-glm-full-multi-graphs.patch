+# -- CUDA graphs of the batched verify (multi-stream milestone 4) ----------------------------------------------------
+# A window's launches depend on its rows R and the selection's bucket NT alone (everything else is in FullRows' device
+# tables, the static token ids and the static scratch), so one graph a (R, NT) serves every mix of streams, positions
+# and extents: R 1 .. 16, NT 0 (no sparse row: no selection) and every bucket a stream's context can reach. The graphs
+# share one memory pool (the engine's, when it has graphs: the windows never run at the same time), and what a graph
+# holds beyond the pool is its executable (its kernel nodes).
+
+GRAPH_NODE_BYTES = 2048        # device memory a captured kernel node takes, at most (estimate; tests/gpu measures it)
+LAYER_LAUNCHES = 64            # kernels (and collectives) a full GLM-5.3 layer launches in a batched window, at most
+HEAD_LAUNCHES = 32             # the embedding, the final norm, the head, the taps
+DRAFT_LAYER_LAUNCHES = 24      # a DSpark layer's kernels in a block pass or a context update, at most
+DRAFT_HEAD_LAUNCHES = 48       # a DSpark block pass's embedding gather, norms, head, top-k, candidates, confidence
+
+
+def graph_mode(value: str | None = None) -> str:
+    """TF_GLM_MULTI_GRAPHS (full GLM-5.3 under --parallel): "all" (default; "1"): a graph a window's rows R (1 ..
+    16) and token bucket NT (0 and every bucket a stream reaches); "top": a graph a R for windows without sparse rows
+    and one for sparse windows at the largest bucket (every sparse window then runs at that bucket, eager or replayed:
+    the same bits, as a row's selection reads only its own columns, fewer graphs); "0": eager."""
+
+    import os
+
+    value = (os.environ.get("TF_GLM_MULTI_GRAPHS", "") if value is None else value).strip().lower()
+    if value in ("", "1", "all"):
+        return "all"
+    if value in ("0", "top"):
+        return value
+    raise ValueError(f"TF_GLM_MULTI_GRAPHS: 1 (all), top or 0, not {value!r}")
+
+
+def reach_buckets(capacity: int, most: int | None = None) -> list[int]:
+    """The selection buckets (``dsa_full.rows_bucket``) a window can take when its streams see at most ``most``
+    tokens (default: the selection's ``capacity``), ascending."""
+
+    capacity = int(capacity)
+    most = capacity if most is None else min(capacity, int(most))
+    out, b = [], dsa_full.MIN_BUCKET
+    while True:
+        out.append(min(capacity, b))
+        if b >= most or b >= capacity:
+            return sorted(set(out))
+        b *= 2
+
+
+def graph_keys(rows: int, nts: Sequence[int]) -> list[tuple[int, int]]:
+    """The (R, NT) graphs of windows of 1 .. ``rows`` rows and buckets ``nts`` (0: no sparse row)."""
+
+    return [(R, NT) for NT in nts for R in range(1, int(rows) + 1)]
+
+
+def graph_count(rows: int, capacity: int, most: int | None, *, indexed: bool, mode: str = "all") -> int:
+    """How many verify graphs ``FullSegVerify.capture`` takes (``mode``: ``graph_mode``)."""
+
+    if mode == "0":
+        return 0
+    if not indexed:
+        return int(rows)
+    nb = len(reach_buckets(capacity, most))
+    return int(rows) * (1 + (min(nb, 1) if mode == "top" else nb))
+
+
+def verify_graph_bytes(layers: int, graphs: int) -> int:
+    """The verify graphs' executables beyond the shared pool: ``graphs`` x (its kernel nodes x GRAPH_NODE_BYTES)."""
+
+    return int(graphs) * (int(layers) * LAYER_LAUNCHES + HEAD_LAUNCHES) * GRAPH_NODE_BYTES
+
+
+def draft_graph_bytes(draft_layers: int, streams: int, tap_rows: int) -> int:
+    """The DSpark stream contexts' graphs (``dspark_multi.DSparkMulti.capture``): per context a block pass and a
+    context update of 1 .. ``tap_rows`` rows."""
+
+    nodes = int(draft_layers) * DRAFT_LAYER_LAUNCHES + DRAFT_HEAD_LAUNCHES
+    return int(streams) * (int(tap_rows) + 1) * nodes * GRAPH_NODE_BYTES
+
+
+def seg_bytes(rows: int, capacity: int, k: int, *, indexed: bool) -> int:
+    """``FullSegVerify``'s own device buffers beyond ``FullBatchedVerify``'s: the row tables and (with index caches)
+    the selection's scratch (``RowsScratch``: fp32 scores [rows, capacity], lists [rows, k], counts)."""
+
+    tables = 4 * int(rows) * 4
+    if not indexed:
+        return tables
+    return tables + int(rows) * (int(capacity) * 4 + int(k) * 4 + 4)
+
+
+def capture_graph(fn, pool, warm: int = 2):
+    """A CUDA graph of ``fn()`` in ``pool``, after ``warm`` eager runs (Triton's compiles, the allocator)."""
+
+    for _ in range(warm):
+        fn()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g, pool=pool):
+        fn()
+    return g
+
