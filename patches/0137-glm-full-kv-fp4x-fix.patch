+def e4m3_bits(v: torch.Tensor) -> torch.Tensor:
+    """fp32 values -> e4m3 (float8_e4m3fn) code bytes by integer arithmetic on their bits: round to nearest, ties to
+    even, the sign kept (also on zeros), saturating at +-448; the definition ``e4m3_code`` (the write kernels' encoder)
+    equals bit for bit on every finite input (no hardware conversion involved on either side)."""
+    b = v.float().contiguous().view(torch.int32).to(torch.int64) & 0xFFFFFFFF
+    sign = (b >> 31) & 1
+    a = b & 0x7FFFFFFF
+    e = a >> 23                                                # biased fp32 exponent
+    m = a & 0x7FFFFF
+    # normal e4m3 (|v| >= 2^-6, biased fp32 exponent >= 121): 3 mantissa bits, ties to even
+    q = m >> 20
+    rem = m & 0xFFFFF
+    up = (rem > 0x80000) | ((rem == 0x80000) & ((q & 1) == 1))
+    q = q + up.to(torch.int64)
+    en = e - 120 + (q >> 3)                                    # e4m3 biased exponent (bias 7), carry from q == 8
+    normal = (en << 3) | (q & 7)
+    # subnormal e4m3 (|v| < 2^-6): the multiple of 2^-9 nearest |v|, ties to even (8 is the smallest normal, 2^-6)
+    full = m | 0x800000                                        # |v| = full x 2^(e - 150); in units of 2^-9: full >> sh
+    sh = (141 - e).clamp(min=0, max=63)                        # |v| / 2^-9 = full x 2^(e - 141)
+    k = full >> sh.clamp(max=62)
+    rbits = full - (k << sh.clamp(max=62))
+    halfv = torch.where(sh > 0, torch.ones_like(sh) << (sh - 1).clamp(min=0), torch.zeros_like(sh))
+    upk = (sh > 0) & ((rbits > halfv) | ((rbits == halfv) & ((k & 1) == 1)))
+    k = torch.where(sh > 25, torch.zeros_like(k), k + upk.to(torch.int64))
+    k = torch.where(e == 0, torch.zeros_like(k), k)            # fp32 zeros and subnormals: 0
+    mag = torch.where(e >= 121, normal, k)
+    mag = torch.minimum(mag, torch.full_like(mag, 0x7E))       # saturate at 448
+    return ((sign << 7) | mag).to(torch.uint8)
