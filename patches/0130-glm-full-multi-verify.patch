+
+# full GLM-5.3: the rows a batched window takes at most. Up to 16 rows every row-independent kernel keeps the tile it
+# runs a lone stream's window on (qmm's 16-row bucket, the absorb's one row a program, 16-head attention tiles), so
+# the bits cannot move with the window's size; past it the tiles change (claimed bit-neutral, unproven on the GPU).
+FULL_MAX_ROWS = 16
+
+
+class FullBatchedVerify:
+    """Full GLM-5.3's batched verify: ONE eager forward over every segment's rows back to back (``forward.compute``
+    with a ``mixer``), each segment a stream's window on its own ``State`` (its extent of the shared ``Caches``, its
+    ``Slots`` position). Full GLM-5.3 has no KDA layers and no hyper-connections, so what is not attention is row-wise:
+    the embedding, the RMSNorms, the attention projections (``forward.dsa_full_front``), the value rows, o_proj and
+    its collective (``forward.dsa_full_out``), the MoE and its collective, the head, all on the whole window, once.
+    Per segment, on that stream's caches at its positions (``forward.dsa_full_rows``, the same calls a lone window of
+    the segment's rows makes): latent, rotary and index key writes, query RoPE, top-k selection, dense / sparse
+    attention. Each segment's selection is carried through the shared indexer layers on its own (``self.topk``).
+
+    So every segment's logits are the bits of that stream's window run alone (``forward.forward`` at its state), and
+    a commit of any rows leaves each stream where its own window and commit would. Milestone 1: eager only (no CUDA
+    graphs), no drafter, no context parallelism (its caches hold one extent at base 0), at most FULL_MAX_ROWS rows.
+    ``e``: anything with the engine's ``w`` and ``caches`` (the pool the states view); ``taps``: DFlash2-style tap
+    layers to return, or ()."""
+
+    def __init__(self, e, *, taps: Sequence[int] = (), rows: int = FULL_MAX_ROWS) -> None:
+        from . import latent
+        from .forward import Buffers
+
+        w = e.w
+        c = w.cfg
+        if not c.full:
+            raise ValueError("FullBatchedVerify is full GLM-5.3's (GLM-5.3-Flash: BatchedVerify)")
+        if int(w.meta.get("cp", 1)) > 1:
+            raise ValueError("context parallelism serves one stream (its caches keep one extent at base 0)")
+        if not latent.ENABLED:
+            raise ValueError("batched verify windows need the latent cache (TF_GLM_LATENT=1)")
+        if not 1 <= rows <= FULL_MAX_ROWS:
+            raise ValueError(f"a full GLM-5.3 batched window holds 1 .. {FULL_MAX_ROWS} rows, not {rows}")
+        self.e, self.w, self.rows_max = e, w, rows
+        self.b = Buffers(w, rows, e.caches.rows)
+        if taps:
+            self.b.set_taps(tuple(taps), c.hidden)
+        self.taps = bool(taps)
+        self.segments: list[Segment] = []
+        self.topk: list = []
+        self.R = 0
+
+    def _stage(self, tokens: list[int]) -> None:
+        b = self.b
+        R = len(tokens)
+        if b.staged is not None:
+            b.staged.synchronize()
+        b.ids_host[:R].numpy()[:] = tokens
+        b.ids[:R].copy_(b.ids_host[:R], non_blocking=True)
+        if b.staged is not None:
+            b.staged.record()
+
+    def _check(self, segments: Sequence[Segment]) -> int:
+        """The window's rows; refuses windows the forward cannot run exactly: too many rows, an empty segment, two
+        segments on one state or on overlapping extents (one's writes would land in the other's keys)."""
+
+        from .forward import check_room
+
+        R = 0
+        spans = []
+        for seg in segments:
+            st, n = seg.st, len(seg.tokens)
+            if n < 1:
+                raise ValueError("a segment needs at least one token")
+            check_room(self.w, st, n)
+            spans.append((st.base, st.base + st.capacity, id(st)))
+            R += n
+        if not segments or R > self.rows_max:
+            raise ValueError(f"a window of {R} rows in {len(segments)} segments, the batched buffers hold "
+                             f"{self.rows_max}")
+        spans.sort()
+        for (a0, a1, ia), (b0, b1, ib) in zip(spans, spans[1:]):
+            if ia == ib or b0 < a1:
+                raise ValueError("the segments' states must be distinct streams on disjoint extents")
+        return R
+
+    @torch.no_grad()
+    def forward(self, segments: Sequence[Segment]) -> Verified:
+        from .forward import compute
+
+        R = self._check(segments)
+        self._stage([t for seg in segments for t in seg.tokens])
+        self.segments, self.R = list(segments), R
+        self.topk = [None] * len(segments)          # each segment's carried selection, reset as b.topk is
+        logits = compute(self.w, None, self.b, R, mixer=self._mixer)
+        out, taps, at = [], [], 0
+        for seg in segments:
+            n = len(seg.tokens)
+            out.append(logits[at:at + n])
+            taps.append(torch.cat([t[at:at + n] for t in self.b.taps], dim=1) if self.taps else None)
+            at += n
+        return Verified(out, taps)
+
+    def _mixer(self, layer):
+        """A layer's attention over the whole window: the projections and the output on every row, the rest per
+        segment on its own stream's caches and positions."""
+
+        from . import prof
+        from .forward import chunks_for, dsa_full_front, dsa_full_out, dsa_full_rows
+
+        if layer.kind != "dsa":
+            raise ValueError(f"layer {layer.index}: full GLM-5.3 has attention layers only")
+        w, b, R = self.w, self.b, self.R
+        with prof.timed("dsa (total)"):
+            dsa_full_front(layer, w, b, 0, R)
+            at = 0
+            for k, seg in enumerate(self.segments):
+                st, n = seg.st, len(seg.tokens)
+                di = st.dsa_index[layer.index]
+                keys = None
+                if st.index is not None and layer.dsa.index is not None:
+                    keys = st.index[st.index_of[layer.index]][2]
+                # the lone window's arguments: its rows, its chunk count, its host position (dense / sparse rows,
+                # the selection's token bucket over its own extent)
+                self.topk[k] = dsa_full_rows(layer, w, st.kc[di], st.kr[di], st.pos_dev, b, n, chunks_for(st, n),
+                                             keys, st.pos, None, indexed=st.index is not None, topk=self.topk[k],
+                                             lo=at)
+                at += n
+            return dsa_full_out(layer, w, b, R)
+
+    @torch.no_grad()
+    def commit(self, segments: Sequence[Segment], keeps: Sequence[int]) -> None:
+        """Each segment keeps its first ``keeps[k]`` rows (``forward.commit``: full GLM-5.3 has no recurrent state, so
+        its position advances; the caches' rows past it are rewritten before anything reads them)."""
+
+        from .forward import commit
+
+        if [id(s) for s in segments] != [id(s) for s in self.segments]:
+            raise ValueError("commit takes the segments of the last forward")
+        if len(keeps) != len(segments) or any(not 1 <= k <= len(s.tokens) for s, k in zip(segments, keeps)):
+            raise ValueError("keep must be in 1..rows for every segment")
+        for seg, keep in zip(segments, keeps):
+            commit(self.w, seg.st, self.b, len(seg.tokens), keep)
+        self.segments = []
