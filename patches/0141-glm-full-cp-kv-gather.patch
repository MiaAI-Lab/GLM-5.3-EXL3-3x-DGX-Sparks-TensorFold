+# TF_GLM_CP_KV_GATHER (0141; default 1): context-parallel prompt chunks gather each layer's visible context (every
+# rank's latent and rotary rows of the positions before the chunk's end: ~430 B a token at fp4, ~650 at fp8) instead of
+# exchanging every row's queries and attention partials (~50 KB a row and layer: 3,072 rows x 79 layers ~ 12 GB a
+# chunk); each rank then attends its own heads over each row's whole top-k (ascending position) in one call of Mia's
+# sparse attention, as a rank does without context parallelism. Decode windows keep dsa_full_cp's path. 0: cp_prompt.
+CP_KV_GATHER = os.environ.get("TF_GLM_CP_KV_GATHER", "1") != "0"
+
+
+def cp_kvg_buffers(b: Buffers, lc: torch.Tensor, kr: torch.Tensor, G: int, S: int):
+    """The gathered latent and rotary rows of one layer, [G * S, ...] each (every rank's first S local slots,
+    rank-major: position p at row (p % G) S + p // G): views of one pair of allocations kept on the prompt buffer, G x
+    the planes' rows (ceil(capacity / G) + 1), made at the first chunk (``geometry.full_cp_bytes`` counts them)."""
+    held = getattr(b, "cp_kvg", None)
+    rows = G * lc.shape[0]
+    if held is None or held[0].shape[0] < rows or held[0].dtype != lc.dtype or held[1].dtype != kr.dtype \
+            or held[0].shape[1:] != lc.shape[1:] or held[1].shape[1:] != kr.shape[1:]:
+        b.cp_kvg = None
+        held = b.cp_kvg = (torch.empty((rows, *lc.shape[1:]), dtype=lc.dtype, device=lc.device),
+                           torch.empty((rows, *kr.shape[1:]), dtype=kr.dtype, device=kr.device))
+    return held[0][:G * S], held[1][:G * S]
+
+
+def _words(t: torch.Tensor) -> torch.Tensor:
+    """A contiguous tensor's bytes as int32 words (the collectives' types; every cache row is a multiple of 4 B)."""
+    return t.reshape(-1).view(torch.int32)
