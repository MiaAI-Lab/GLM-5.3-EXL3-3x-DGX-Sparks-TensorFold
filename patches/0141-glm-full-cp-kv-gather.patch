+def owner_lists(cands: torch.Tensor, thresholds: torch.Tensor, G: int, S: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """TF_GLM_CP_KV_GATHER (forward.cp_prompt_kvg): a row owner's whole lists. cands [G, M, k] (every rank's
+    ``select_local`` candidates of the owner's M rows, rank order) and each row's threshold (``select_threshold``) ->
+    (rows [M, k] int32, counts [M] int32): every rank's candidates that are real and >= the threshold (the uint64 order
+    of select_keep, so the ranks' kept parts together), as global positions in ascending order, which is the
+    replicated dsa_full.select_tokens list of the row; each position p written as the row (p % G) S + p // G of the
+    gathered planes (every rank's first S local slots, rank-major), -1 past the count."""
+    G_, M, k = cands.shape
+    if G_ != G or cands.dtype != torch.int64 or thresholds.dtype != torch.int64 or thresholds.numel() < M:
+        raise ValueError("owner_lists: int64 candidates [G, M, k] and an int64 threshold a row")
+    u = cands.permute(1, 0, 2).reshape(M, G * k)
+    flip = torch.full((), -(1 << 63), dtype=torch.int64, device=u.device)    # unsigned order as signed
+    keep = ((u ^ flip) >= (thresholds[:M, None] ^ flip)) & (u != 0)
+    big = torch.iinfo(torch.int64).max
+    pos = torch.where(keep, 0xFFFFFFFF - (u & 0xFFFFFFFF), big)
+    pos = torch.sort(pos, dim=1).values[:, :k]
+    rows = torch.where(pos != big, (pos % G) * S + pos // G, -1).to(torch.int32).contiguous()
+    return rows, keep.sum(1).to(torch.int32)
+
