+def cp_kvg_all_visible(b: Buffers, R: int, host_pos: int, G: int, S: int, k: int, dev):
+    """cp_prompt_kvg's lists for a chunk whose rows see at most k tokens: row r every position 0 .. host_pos + r,
+    ascending, as rows of the gathered planes ((p % G) S + p // G), and its count; what ``dcp.owner_lists`` gives a
+    row with fewer than k candidates, so the row has the same list in any chunk."""
+    p = torch.arange(k, dtype=torch.int64, device=dev)
+    rows = ((p % G) * S + p // G).to(torch.int32)
+    tokens = rows.expand(R, k).contiguous()
+    counts = (torch.arange(R, dtype=torch.int32, device=dev) + int(host_pos) + 1).clamp(max=k)
+    return tokens, counts
