+def dspark_terms(drafter, tokens: np.ndarray, anchor: int) -> tuple[np.ndarray, float, np.ndarray, np.ndarray]:
+    """DSpark's sequential terms for every pair the chain could meet, each its own float64 expression (same bits as
+    ``dspark.Drafter.chain``): (Markov bias of slot 0's candidates after the anchor [K], the confidence head's Markov
+    part after the anchor, Markov biases of slot d's candidates after slot d-1's candidate a [D - 1, K, K], the
+    confidence head's Markov part after slot d-1's candidate a [D - 1, K])."""
+
+    depth, k = tokens.shape
+
+    def cm(emb):
+        return float(drafter.conf_m @ emb) if drafter.conf_m is not None and emb is not None else 0.0
+
+    emb = drafter.markov_embed(anchor)
+    mb0, cm0 = drafter.markov_bias(tokens[0], emb), cm(emb)
+    mbs = np.zeros((max(depth - 1, 0), k, k), dtype=np.float64)
+    cms = np.zeros((max(depth - 1, 0), k), dtype=np.float64)
+    for d in range(1, depth):
+        for a in range(k):
+            emb = drafter.markov_embed(int(tokens[d - 1, a]))
+            mbs[d - 1, a] = drafter.markov_bias(tokens[d], emb)
+            cms[d - 1, a] = cm(emb)
+    return mb0, cm0, mbs, cms
+
